(version 1)
(allow default)
(deny process-exec)
(allow process-exec (literal (param "PYTHON")))
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.securityd.xpc"))
(deny network*)
(allow network-outbound (remote tcp "localhost:8283"))
(deny file-write*)
(deny file-read-data (subpath (param "USER_HOME")))
(allow file-read-data (literal (param "SCRIPT")) (literal (param "IMAGE")))
