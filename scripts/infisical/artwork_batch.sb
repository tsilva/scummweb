(version 1)
(allow default)
(deny process-exec)
(allow process-exec (literal (param "PYTHON")))
(deny network*)
(allow network-outbound (remote tcp "localhost:8283"))
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.securityd.xpc"))
(deny file-write*)
(deny file-read-data (subpath (param "USER_HOME")))
(allow file-read-data
  (subpath (param "PYTHON_ROOT"))
  (literal (param "CLIENT"))
  (literal (param "ADAPTER"))
  (literal (param "PUBLISHER"))
  (literal (param "MANIFEST"))
  (subpath (param "OBJECT_ROOT")))
