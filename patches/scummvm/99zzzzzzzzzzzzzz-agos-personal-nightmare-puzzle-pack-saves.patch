+#ifdef __EMSCRIPTEN__
+bool AGOSEngine_PuzzlePack::canSaveGameStateCurrently(Common::U32String *msg) {
+	if (!hasFeature(kSupportsSavingDuringRuntime))
+		return false;
+
+	// DIMP uses its own device controls while the standard AGOS mouse is hidden.
+	if (getGameId() == GID_DIMP)
+		return _scummWebAgentIdle && !_videoLockOut && _variableArray[150] != 0;
+
+	// The title presentation runs a demonstration board before showing the map.
+	return AGOSEngine::canSaveGameStateCurrently(msg) && getBitFlag(20) && !getBitFlag(110);
+}
+
+Common::Error AGOSEngine_PuzzlePack::saveGameState(int slot, const Common::String &, bool isAutosave) {
+	if (isAutosave || slot != 1 || !canSaveGameStateCurrently())
+		return Common::kWritingFailed;
+
+	if (getGameId() == GID_SWAMPY)
+		resumePuzzleClock();
+	return saveGame(slot, nullptr) ? Common::kNoError : Common::kWritingFailed;
+}
+
+Common::Error AGOSEngine_PuzzlePack::loadGameState(int slot) {
+	if (slot != 1 || !canLoadGameStateCurrently())
+		return Common::kReadingFailed;
+
+	const bool dimp = getGameId() == GID_DIMP;
+	Subroutine *redraw = getSubroutineByID(dimp ? 1522 : 8503);
+	if (!redraw || !loadGame(genSaveName(slot)))
+		return Common::kReadingFailed;
+
+	if (dimp) {
+		// The native startup restore resets its session counter and redraws the pet.
+		_variableArray[121] = 0;
+	} else {
+		// Subroutine 8502 normally loads progress at startup and enters the map
+		// (database item 1). Discard the current board's timers and input flags.
+		killAllTimers();
+		setItemParent(me(), derefItem(3));
+		setBitFlag(1, false);
+		setBitFlag(2, false);
+		setBitFlag(30, false); // Reload the map palette after leaving a board.
+		setBitFlag(31, false);
+		setBitFlag(107, false);
+	}
+	startSubroutine(redraw);
+	return Common::kNoError;
+}
+#endif
 
