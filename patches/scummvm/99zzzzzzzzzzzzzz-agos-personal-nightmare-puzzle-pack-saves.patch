 // Personal Nightmare specific
+#ifdef __EMSCRIPTEN__
+bool AGOSEngine_PN::canSaveGameStateCurrently(Common::U32String *) {
+	return _scummWebAgentIdle && _inputReady && !_videoLockOut && !_scummWebPendingLoadSlot;
+}
+
+Common::Error AGOSEngine_PN::saveGameState(int slot, const Common::String &desc, bool isAutosave) {
+	if (isAutosave || slot < 1 || slot > kLastPlayerSaveSlot || !canSaveGameStateCurrently())
+		return Common::kWritingFailed;
+
+	char previousCaption[sizeof(_saveFile)];
+	memcpy(previousCaption, _saveFile, sizeof(_saveFile));
+	memset(_saveFile, 0, sizeof(_saveFile));
+	memcpy(_saveFile, desc.c_str(), MIN<uint>(8, desc.size()));
+	const bool saved = saveFile(genSaveName(slot));
+	memcpy(_saveFile, previousCaption, sizeof(_saveFile));
+	return saved ? Common::kNoError : Common::kWritingFailed;
+}
+
+Common::Error AGOSEngine_PN::loadGameState(int slot) {
+	if (slot < 1 || slot > kLastPlayerSaveSlot || !canLoadGameStateCurrently())
+		return Common::kReadingFailed;
+
+	Common::InSaveFile *in = _saveFileMan->openForLoading(genSaveName(slot));
+	if (!in)
+		return Common::kReadingFailed;
+	const bool valid = in->size() == 10 + _quickptr[6] - _quickptr[2] &&
+		in->seek(8) && in->readUint16BE() == 0x2921;
+	delete in;
+	if (!valid)
+		return Common::kReadingFailed;
+
+	_scummWebPendingLoadSlot = slot;
+	_scummWebAgentIdle = false; // Acknowledge only after returning to the command prompt.
+	return Common::kNoError;
+}
+#endif
