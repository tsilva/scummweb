@@ -44,8 +44,76 @@
 #include "graphics/cursorman.h"
 
 #include "engines/scummweb-intro.h"
+#include "engines/scummweb-agent-loop.h"
+#include "engines/metaengine.h"
 
 namespace Mohawk {
+
+#ifdef __EMSCRIPTEN__
+static constexpr uint32 kLivingBooksPageTag = MKTAG('L', 'B', 'P', '1');
+
+bool LivingBooksPageSave::supports(const Common::String &gameId, const Common::String &edition) {
+	Common::String extra = edition;
+	extra.toLowercase();
+	return extra.hasPrefix("demo") && (gameId == "tortoise" || gameId == "arthurbday" ||
+		gameId == "grandma" || gameId == "arthur" || gameId == "ruff" || gameId == "newkid");
+}
+
+bool LivingBooksPageSave::read(Common::SeekableReadStream &stream) {
+	if (stream.readUint32BE() != kLivingBooksPageTag)
+		return false;
+	const byte savedMode = stream.readByte();
+	page = stream.readUint16LE();
+	subpage = stream.readUint16LE();
+	language = stream.readUint16LE();
+	if (stream.err() || stream.eos() || !page || !language ||
+			(savedMode != kLBReadMode && savedMode != kLBPlayMode))
+		return false;
+	mode = static_cast<LBMode>(savedMode);
+	return true;
+}
+
+bool MohawkEngine_LivingBooks::hasFeature(EngineFeature f) const {
+	if (f == kSupportsSavingDuringRuntime || f == kSupportsLoadingDuringRuntime)
+		return scummweb_agent_game_loop_enabled() && LivingBooksPageSave::supports(getGameId(), ConfMan.get("extra"));
+	return MohawkEngine::hasFeature(f);
+}
+
+bool MohawkEngine_LivingBooks::canSaveGameStateCurrently(Common::U32String *) {
+	return _page && (_curMode == kLBReadMode || _curMode == kLBPlayMode);
+}
+
+bool MohawkEngine_LivingBooks::canLoadGameStateCurrently(Common::U32String *) {
+	return _page && _curMode != kLBIntroMode;
+}
+
+Common::Error MohawkEngine_LivingBooks::saveGameStream(Common::WriteStream *stream, bool isAutosave) {
+	if (isAutosave || !canSaveGameStateCurrently())
+		return Common::kWritingFailed;
+
+	stream->writeUint32BE(kLivingBooksPageTag);
+	stream->writeByte(_curMode);
+	stream->writeUint16LE(_curPage);
+	stream->writeUint16LE(_curSubPage);
+	stream->writeUint16LE(_curLanguage);
+	return stream->err() ? Common::kWritingFailed : Common::kNoError;
+}
+
+Common::Error MohawkEngine_LivingBooks::loadGameStream(Common::SeekableReadStream *stream) {
+	LivingBooksPageSave saved;
+	if (!saved.read(*stream) || saved.page > _numPages || saved.language > _numLanguages)
+		return Common::kReadingFailed;
+
+	const uint16 previousLanguage = _curLanguage;
+	_curLanguage = saved.language;
+	if (!loadPage(saved.mode, saved.page, saved.subpage)) {
+		_curLanguage = previousLanguage;
+		return Common::kReadingFailed;
+	}
+	_curSelectedPage = saved.page;
+	return Common::kNoError;
+}
+#endif
 
