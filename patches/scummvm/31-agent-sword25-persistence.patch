+#ifdef __EMSCRIPTEN__
+bool LuaScriptEngine::executeAgentBoot(const Common::String &fileName) {
+	auto *package = Kernel::getInstance()->getPackage();
+	uint size;
+	byte *data = package->getFile(fileName, &size);
+	if (!data)
+		return false;
+
+	Common::String script((const char *)data, size);
+	delete[] data;
+	const Common::String loopMarker = "while true do";
+	const Common::String persistMarker = "Persistence:Do()";
+	const size_t loop = script.find(loopMarker);
+	const size_t persist = script.find(persistMarker);
+	if (loop == Common::String::npos || persist == Common::String::npos || loop >= persist ||
+			script.find(loopMarker, loop + loopMarker.size()) != Common::String::npos ||
+			script.find(persistMarker, persist + persistMarker.size()) != Common::String::npos) {
+		warning("Unsupported Sword25 main loop for agent controls");
+		return false;
+	}
+
+	script.insertString("AgentFrame(CurrentRoom ~= nil and Interface:GetMode() == 'default' and not Menu:IsActive())\n\t", persist);
+	script.insertString("local AgentFrame = Kernel.AgentFrame\n", loop);
+	return executeBuffer((const byte *)script.c_str(), script.size(), "@" + package->getAbsolutePath(fileName));
+}
+#endif
+
 bool LuaScriptEngine::executeFile(const Common::String &fileName) {
+#ifdef __EMSCRIPTEN__
+	if (fileName == "/system/boot.lua" && scummweb_agent_game_loop_enabled())
+		return executeAgentBoot(fileName);
+#endif
 #ifdef DEBUG
 	int __startStackDepth = lua_gettop(_state);
 #endif
