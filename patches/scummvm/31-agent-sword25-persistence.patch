+#ifdef __EMSCRIPTEN__
+void Sword25Engine::serviceAgentFrame(bool playable) {
+	_agentPlayable = playable;
+	scummweb_agent_game_loop();
+	_agentPlayable = false;
+}
+
+Common::Error Sword25Engine::saveGameState(int slot, const Common::String &, bool isAutosave) {
+	if (isAutosave || !_agentPlayable || slot < 1 || uint(slot) >= PersistenceService::getSlotCount())
+		return Common::kWritingFailed;
+	Kernel::getInstance()->getGfx()->saveThumbnailScreenshot("");
+	return PersistenceService::getInstance().saveGame(slot, "") ? Common::kNoError : Common::kWritingFailed;
+}
+
+Common::Error Sword25Engine::loadGameState(int slot) {
+	if (!_agentPlayable || slot < 1 || uint(slot) >= PersistenceService::getSlotCount())
+		return Common::kReadingFailed;
+	auto &persistence = PersistenceService::getInstance();
+	if (!persistence.isSlotOccupied(slot) || !persistence.isSavegameCompatible(slot))
+		return Common::kReadingFailed;
+
+	// The game processes its queue immediately after this frame callback,
+	// including the Lua handlers that rebuild the UI after a restore.
+	const auto request = Common::String::format("Persistence:LoadGame(%d)", slot + 1);
+	return Kernel::getInstance()->getScript()->executeString(request) ? Common::kNoError : Common::kReadingFailed;
+}
+#endif
+
 bool Sword25Engine::hasFeature(EngineFeature f) const {
+#ifdef __EMSCRIPTEN__
+	if (f == kSupportsSavingDuringRuntime || f == kSupportsLoadingDuringRuntime)
+		return scummweb_agent_game_loop_enabled();
+#endif
 	return
 		(f == kSupportsReturnToLauncher);
 	// TODO: Implement more of these features?!
