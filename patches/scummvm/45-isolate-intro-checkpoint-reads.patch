 Common::InSaveFile *DefaultSaveFileManager::openForLoading(const Common::String &filename) {
+#ifdef __EMSCRIPTEN__
+	// The startup checkpoint is deliberately outside the save directory and cache.
+	if (EM_ASM_INT({ return !!globalThis.__scummwebHasIntroCheckpoint?.(UTF8ToString($0)); }, filename.c_str())) {
+		clearError();
+		const Common::FSNode checkpoint(Common::Path("/tmp/scummweb-intro").appendComponent(filename));
+		return Common::wrapCompressedReadStream(checkpoint.createReadStream());
+	}
+#endif
 	// Assure the savefile name cache is up-to-date.
 	assureCached(getSavePath());
 	if (getError().getCode() != Common::kNoError)
