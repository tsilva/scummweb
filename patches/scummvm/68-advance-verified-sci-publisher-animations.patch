+#ifdef __EMSCRIPTEN__
+bool EngineState::isBrowserTimedOpening() const {
+	const auto *globals = variables[VAR_GLOBAL];
+	if (_delayedRestoreGameId != -1 || !globals || variablesMax[VAR_GLOBAL] <= kGlobalVarNewRoomNo ||
+			!globals[kGlobalVarNewRoomNo].isNumber())
+		return false;
+
+	const int room = currentRoomNumber();
+	// These publisher rooms advance on script time instead of handling
+	// Escape. The original title menus and first gameplay rooms are separate.
+	switch (g_sci->getGameId()) {
+	case GID_GK1:
+		return room == 94;
+	case GID_KQ5:
+		return room == 99;
+	case GID_KQ7:
+		return room == 15;
+	case GID_PEPPER:
+		return room == 100;
+	default:
+		return false;
+	}
+}
+#endif
