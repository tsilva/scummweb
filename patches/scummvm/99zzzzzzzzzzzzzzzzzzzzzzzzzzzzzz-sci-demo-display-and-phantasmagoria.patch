+#ifdef __EMSCRIPTEN__
+static constexpr uint32 kHostedSci16ScreenTag = MKTAG('S', 'W', '1', '6');
+
+void GfxScreen::saveHostedDemoScreen(Common::WriteStream &stream) const {
+	stream.writeUint32BE(kHostedSci16ScreenTag);
+	stream.writeUint16LE(_width);
+	stream.writeUint16LE(_height);
+	stream.writeUint16LE(_displayWidth);
+	stream.writeUint16LE(_displayHeight);
+	stream.write(_visualScreen, _pixels);
+	stream.write(_priorityScreen, _pixels);
+	stream.write(_controlScreen, _pixels);
+	stream.write(_displayScreen, _displayPixels);
+}
+
+void GfxScreen::queueHostedDemoScreen(Common::SeekableReadStream &stream) {
+	const uint32 bytes = 3 * _pixels + _displayPixels;
+	if (stream.size() - stream.pos() != 12 + bytes ||
+		stream.readUint32BE() != kHostedSci16ScreenTag ||
+		stream.readUint16LE() != _width || stream.readUint16LE() != _height ||
+		stream.readUint16LE() != _displayWidth || stream.readUint16LE() != _displayHeight)
+		return;
+
+	_hostedDemoScreen.resize(bytes);
+	if (stream.read(_hostedDemoScreen.data(), bytes) != bytes || stream.err())
+		_hostedDemoScreen.clear();
+}
+
+void GfxScreen::restoreHostedDemoScreen() {
+	if (_hostedDemoScreen.empty())
+		return;
+
+	// SCI replays the saved room before polling for its first event. Restore
+	// script-painted labels after the room has rebuilt its resources.
+	const byte *data = _hostedDemoScreen.data();
+	memcpy(_visualScreen, data, _pixels);
+	memcpy(_priorityScreen, data + _pixels, _pixels);
+	memcpy(_controlScreen, data + 2 * _pixels, _pixels);
+	memcpy(_displayScreen, data + 3 * _pixels, _displayPixels);
+	_hostedDemoScreen.clear();
+	copyToScreen();
+}
+#endif
 
