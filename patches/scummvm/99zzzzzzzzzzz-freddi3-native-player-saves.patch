+#ifdef __EMSCRIPTEN__
+static char freddi3SlotSuffix(int slot) {
+	return slot < 10 ? '0' + slot : 'a' + slot - 10;
+}
+
+Common::String ScummEngine::freddi3SaveFilename(const char *target, int slot) {
+	const char suffix = freddi3SlotSuffix(slot);
+	const Common::String filename = Common::String::format("%s-freddi3.sg%c", target, suffix);
+	// HE's name-based loader already accepts this older ScummVM convention.
+	const Common::String legacy = Common::String::format("%s.sg%c", target, suffix);
+	Common::SaveFileManager *saves = g_system->getSavefileManager();
+	return saves->exists(legacy) && !saves->exists(filename) ? legacy : filename;
+}
+
+bool ScummEngine::readFreddi3SaveCatalog(const char *target, byte *catalog) {
+	Common::ScopedPtr<Common::InSaveFile> file(g_system->getSavefileManager()->openForLoading(freddi3SaveFilename(target, 0)));
+	return file && file->size() == kFreddi3CatalogSize &&
+		file->read(catalog, kFreddi3CatalogSize) == kFreddi3CatalogSize;
+}
+
+bool ScummEngine::supportsFreddi3PlayerSaves() const {
+	// English Windows CD data. The demo has no native save scripts, and
+	// later Humongous releases do not necessarily share this slot catalog.
+	static const byte cdIndexMD5[] = {0x83, 0x68, 0xf5, 0x52, 0xb1, 0xe3, 0xeb, 0xa5,
+		0x59, 0xf8, 0xd5, 0x59, 0xbc, 0xc4, 0xca, 0xdb};
+	return _game.id == GID_FREDDI3 && _game.heversion == 90 &&
+		memcmp(_gameMD5, cdIndexMD5, sizeof(cdIndexMD5)) == 0 && scummwebIsPlayerControl();
+}
+
+bool ScummEngine::canUseFreddi3PlayerSlot() const {
+	// Room 46 is the game's own save/load interface.
+	return _agentControlBoundary && _roomResource && _currentRoom != 46 &&
+		_userPut > 0 && _cursor.state > 0 && vm.cutSceneStackPointer == 0 &&
+		vm.cutScenePtr[0] == 0 && !_saveLoadFlag;
+}
+
+Common::String ScummEngine::getSaveStateName(int slot) const {
+	if (supportsFreddi3PlayerSaves() && slot >= 1 && slot <= kFreddi3LastSlot)
+		return freddi3SaveFilename(_targetName.c_str(), slot);
+	return makeSavegameName(slot, false);
+}
+
+void ScummEngine::setFreddi3SaveSlot(int slot) {
+	// This is the same name-based operation used by the original HE scripts.
+	_saveLoadFileName = Common::String::format("freddi3.sg%c", freddi3SlotSuffix(slot));
+	_saveLoadSlot = 255;
+	_saveTemporaryState = true;
+}
+
+void ScummEngine::writeFreddi3SaveCaption(int slot, const Common::String &caption) {
+	byte catalog[kFreddi3CatalogSize] = {};
+	const Common::String existing = freddi3SaveFilename(_targetName.c_str(), 0);
+	if (_saveFileMan->exists(existing) && !readFreddi3SaveCatalog(_targetName.c_str(), catalog))
+		return;
+
+	byte *row = catalog + slot * kFreddi3CatalogEntrySize;
+	// The original menu uses picture 721 when a slot has no room picture.
+	WRITE_BE_UINT16(row, 721);
+	Common::strlcpy(reinterpret_cast<char *>(row + 2), caption.c_str(), kFreddi3CatalogEntrySize - 2);
+
+	const Common::String filename = _targetName + "-freddi3.sg0";
+	Common::ScopedPtr<Common::OutSaveFile> out(_saveFileMan->openForSaving(filename, false));
+	if (out) {
+		out->write(catalog, sizeof(catalog));
+		out->finalize();
+	}
+}
+#endif
