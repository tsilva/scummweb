+#include "engines/scummweb-intro.h"
 #include "gob/global.h"
 #include "gob/dataio.h"
 #include "gob/draw.h"
@@ -333,6 +335,33 @@
 
 	getKeyFromBuffer(key);
 
+#ifdef __EMSCRIPTEN__
+	if (_vm->getGameType() == kGameTypeWeen && _vm->getPlatform() == Common::kPlatformAmiga &&
+			_vm->isCurrentTot("intro016.tot") && ScummWebIntro::nativeSkipEnabled()) {
+		const Script &script = *_vm->_game->_script;
+		const int position = script.pos();
+		// This exact Amiga script places its copy-protection input at 2321.
+		// The preceding 2298 call clears the opening's buffered keys.
+		if (position >= 2298) {
+			_browserWeenIntroFinished = true;
+			if (_browserWeenIntroSkipped)
+				ScummWebIntro::skipRequested(false);
+			_browserWeenIntroSkipped = false;
+		} else if (!_browserWeenIntroFinished && script.getSize() == 4270 && position > 0) {
+			static const byte expected[] = {0x01, 0x03, 0x54, 0x00, 0x90, 0x17, 0x3b, 0x00,
+				0x15, 0x00, 0x63, 0xc7, 0x15, 0x0a, 0x63, 0x60};
+			byte signature[sizeof(expected)];
+			const bool matched = script.peek(signature, sizeof(signature), 128 - position) == sizeof(signature) &&
+				memcmp(signature, expected, sizeof(expected)) == 0;
+			if (matched && key.keycode == Common::KEYCODE_INVALID &&
+					(_browserWeenIntroSkipped || ScummWebIntro::skipRequested())) {
+				_browserWeenIntroSkipped = true;
+				ScummWebIntro::skipRequested(false);
+				return kKeyEscape;
+			}
+		}
+	}
+#endif
 	return translateKey(key);
 }
 
