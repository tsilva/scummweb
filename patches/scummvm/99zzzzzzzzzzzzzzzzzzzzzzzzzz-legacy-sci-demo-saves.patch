+#ifdef __EMSCRIPTEN__
+static bool supportsHostedSci16DemoSave(SciGameId id, const ADGameDescription &description) {
+	if (getSciVersion() >= SCI_VERSION_2 || description.platform != Common::kPlatformDOS ||
+		!scummwebIsPlayerControl())
+		return false;
+
+	const char *signature = description.filesDescriptions[0].md5;
+	if (!signature)
+		return false;
+
+	switch (id) {
+	case GID_SLATER:
+		return strcmp(signature, "61b4f74039399e5aa1e737b16d0fc023") == 0;
+	case GID_FUNSEEKER:
+		return strcmp(signature, "7ee6859ef74314f6d91938c3595348a9") == 0;
+	case GID_MSASTROCHICKEN:
+		return strcmp(signature, "5b457cbe5042f557e5b610148171f6c0") == 0;
+	default:
+		return false;
+	}
+}
+#endif
