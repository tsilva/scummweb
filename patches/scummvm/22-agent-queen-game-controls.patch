+#ifdef __EMSCRIPTEN__
+void QueenEngine::serviceAgentControls(bool canChangeState) {
+	if (!_agentEnabled || _agentRestoring)
+		return;
+
+	const int maxManualSlot = getAutosaveSlot() - 1;
+	bool held = false;
+	while (!shouldQuit()) {
+		const int control = EM_ASM_INT({
+			return globalThis.__scummwebAgentBoundary($0, $1);
+		}, _agentCompletedTick, maxManualSlot);
+		_agentCompletedTick = false;
+		if (control < 0) {
+			held = true;
+			_system->delayMillis(10);
+			continue;
+		}
+		if (control == 0) {
+			if (held)
+				_lastUpdateTime = _system->getMillis();
+			return;
+		}
+
+		const bool loading = control > maxManualSlot;
+		const int slot = loading ? control - maxManualSlot : control;
+		Common::String failure;
+		if (!canChangeState || (loading ? !canLoadGameStateCurrently() : !canSaveGameStateCurrently())) {
+			failure = loading ? "Cannot load in the current scene" : "Cannot save in the current scene";
+		} else {
+			const Common::Error result = loading ? loadGameState(slot)
+				: saveGameState(slot, Common::String::format("AgentSCUMM %d", slot));
+			if (result.getCode() != Common::kNoError) {
+				failure = result.getDesc();
+			} else if (loading) {
+				// Let the normal room-entry path rebuild the restored scene.
+				// Its internal updates belong to the load, not a tick wait.
+				_agentRestoring = true;
+				_logic->joeWalk(JWM_NORMAL);
+				_command->clear(true);
+				_input->clearKeyVerb();
+				_input->clearMouseButton();
+				return;
+			}
+		}
+		EM_ASM({ globalThis.__scummwebAgentSaveResult(UTF8ToString($0)); }, failure.c_str());
+	}
+}
+
+void QueenEngine::finishAgentRestore() {
+	if (!_agentRestoring)
+		return;
+	_agentRestoring = false;
+	_system->updateScreen();
+	EM_ASM({ globalThis.__scummwebAgentSaveResult(""); });
+}
+#endif
