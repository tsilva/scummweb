+
+bool ScummEngine::getHeDemoRoomBufferSizes(uint32 &screenBytes, uint32 &maskBytes) {
+	if (!getResourceAddress(rtBuffer, kMainVirtScreen + 1) ||
+		!getResourceAddress(rtBuffer, kMainVirtScreen + 5) || !getResourceAddress(rtBuffer, 9))
+		return false;
+
+	screenBytes = getResourceSize(rtBuffer, kMainVirtScreen + 1);
+	maskBytes = getResourceSize(rtBuffer, 9);
+	return screenBytes > 0 && screenBytes <= kMaxHeRoomBufferBytes && maskBytes > 0 &&
+		maskBytes <= kMaxHeRoomBufferBytes && screenBytes == uint32(getResourceSize(rtBuffer, kMainVirtScreen + 5));
+}
