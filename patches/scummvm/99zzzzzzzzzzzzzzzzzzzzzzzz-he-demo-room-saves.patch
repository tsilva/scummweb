+static constexpr uint32 kHeRoomBuffersTag = MKTAG('H', 'E', 'B', '1');
+static constexpr uint32 kMaxHeRoomBufferBytes = 2 * 1024 * 1024;
+
+static bool supportsHeDemoRoomSaves(const GameSettings &game, const byte *md5) {
+	if (game.heversion < 70 || !scummwebIsPlayerControl())
+		return false;
+
+	static constexpr byte demoIndexes[][16] = {
+		{0xcb, 0x15, 0x59, 0xe8, 0x40, 0x5d, 0x17, 0xa5,
+		 0xa2, 0x78, 0xa6, 0xb5, 0xad, 0x93, 0x38, 0xd1}, // Freddi Fish 3
+		{0xde, 0x4e, 0xfb, 0x91, 0x02, 0x10, 0x73, 0x68,
+		 0x13, 0xc9, 0xa1, 0x18, 0x53, 0x84, 0xba, 0xce}, // Putt-Putt Saves the Zoo
+		{0x0f, 0x59, 0x35, 0xbd, 0x5e, 0x88, 0xba, 0x6f,
+		 0x09, 0xe5, 0x58, 0xd6, 0x44, 0x59, 0x74, 0x6d}, // thinker1
+	};
+	for (const auto &index : demoIndexes) {
+		if (memcmp(md5, index, sizeof(index)) == 0)
+			return true;
+	}
+	return false;
+}
+
+bool ScummEngine::getHeDemoRoomBufferSizes(uint32 &screenBytes, uint32 &maskBytes) {
+	if (!getResourceAddress(rtBuffer, kMainVirtScreen + 1) ||
+		!getResourceAddress(rtBuffer, kMainVirtScreen + 5) || !getResourceAddress(rtBuffer, 9))
+		return false;
+
+	screenBytes = getResourceSize(rtBuffer, kMainVirtScreen + 1);
+	maskBytes = getResourceSize(rtBuffer, 9);
+	return screenBytes > 0 && screenBytes <= kMaxHeRoomBufferBytes && maskBytes > 0 &&
+		maskBytes <= kMaxHeRoomBufferBytes && screenBytes == uint32(getResourceSize(rtBuffer, kMainVirtScreen + 5));
+}
