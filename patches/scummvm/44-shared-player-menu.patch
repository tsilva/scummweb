diff --git a/engines/scummweb-player.h b/engines/scummweb-player.h
new file mode 100644
--- /dev/null
+++ b/engines/scummweb-player.h
@@ -0,0 +1,22 @@
+// ScummWEB's hosted player reuses the native save boundaries without changing
+// the AgentSCUMM protocol or naming.
+#ifndef ENGINES_SCUMMWEB_PLAYER_H
+#define ENGINES_SCUMMWEB_PLAYER_H
+
+#include <emscripten.h>
+#include "common/str.h"
+
+inline bool scummwebIsPlayerControl() {
+	return EM_ASM_INT({ return Boolean(globalThis.scummwebPlayerControls); });
+}
+
+inline Common::String scummwebSaveCaption(int slot) {
+	char caption[128] = {};
+	EM_ASM({
+		const caption = globalThis.__scummwebPlayerSaveCaption?.($0);
+		if (caption) stringToUTF8(caption, $1, $2);
+	}, slot, caption, sizeof(caption));
+	return caption[0] ? Common::String(caption) : Common::String::format("AgentSCUMM %d", slot);
+}
+
+#endif
