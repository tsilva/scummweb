 class LoadGameInputState_NS : public MenuInputState {
+#ifdef __EMSCRIPTEN__
+	bool _hosted = false;
+#endif
 	bool _result;
 	Parallaction *_vm;
 
 public:
 	LoadGameInputState_NS(Parallaction *vm, MenuInputHelper *helper) : MenuInputState("loadgame", helper), _vm(vm), _result(false) { }
 
 	MenuInputState* run() override {
+#ifdef __EMSCRIPTEN__
+		if (_hosted) {
+			if (g_engineFlags & kEngineChangeLocation) {
+				_vm->_scummwebStartupLoad = false;
+				return nullptr;
+			}
+			if (EM_ASM_INT({ return Boolean(globalThis.__scummwebPlayerMenuOpen?.()); }))
+				return this;
+			// Cancelling the browser picker returns to the original New/Saved Game choice.
+			_vm->_scummwebStartupLoad = false;
+			return _helper->getState("selectgame");
+		}
+#endif
 		if (!_result) {
 			_vm->scheduleLocationSwitch("fogne.dough");
 		}
 		return nullptr;
 	}
 
 	void enter() override {
+#ifdef __EMSCRIPTEN__
+		_hosted = EM_ASM_INT({ return Boolean(globalThis.__scummwebRequestPlayerMenu?.("load")); });
+		if (_hosted) {
+			_vm->_scummwebStartupLoad = true;
+			return;
+		}
+#endif
 		_result = _vm->_saveLoad->loadGame();
 	}
 };
 
