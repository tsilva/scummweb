 //////////////////////////////////////////////////////////////////////////
 bool ScEngine::tick() {
+#ifdef __EMSCRIPTEN__
+	ScScript *browserOpening = nullptr;
+	if (ScummWebIntro::nativeSkipEnabled() && !ScummWebIntro::startupFinished() &&
+			BaseEngine::instance().getGameId() == "chivalry") {
+		for (int32 i = 0; i < _scripts.getSize(); i++) {
+			ScScript *script = _scripts[i];
+			// This title script runs after the original instructions dialog.
+			// Wake only its timed waits; retain its actor setup and ChangeScene.
+			if (!script->_thread && script->_filename && script->_bufferSize == 999 &&
+					Common::String(script->_filename).equalsIgnoreCase("scenes\\intro\\scr\\scene_init.script") &&
+					script->_state != SCRIPT_FINISHED && script->_state != SCRIPT_ERROR &&
+					script->_state != SCRIPT_PERSISTENT) {
+				browserOpening = script;
+				break;
+			}
+		}
+		if (browserOpening) {
+			_browserOpeningSeen = true;
+			const bool available = browserOpening->_state == SCRIPT_SLEEPING && _game->_state == GAME_RUNNING;
+			if (ScummWebIntro::skipRequested(available))
+				_browserSkipOpening = true;
+			if (available && _browserSkipOpening)
+				browserOpening->run();
+		} else if (_browserOpeningSeen) {
+			_browserSkipOpening = false;
+			ScummWebIntro::gameplayStarted();
+		}
+	}
+#endif
 	if (_scripts.getSize() == 0) {
 		return STATUS_OK;
 	}
