+// The English DOS demos leave their original save menus disabled during play.
+static bool hasAdventureDemoPlayerSaves(const GameSettings &game, const byte *md5) {
+	if (game.platform != Common::kPlatformDOS || !scummwebIsPlayerControl())
+		return false;
+
+	static constexpr byte fullThrottle[] = {0x32, 0xa4, 0x33, 0xde, 0xa5, 0x6b, 0x86, 0xa5,
 		0x5b, 0x59, 0xe4, 0xff, 0x7d, 0x75, 0x57, 0x11};
