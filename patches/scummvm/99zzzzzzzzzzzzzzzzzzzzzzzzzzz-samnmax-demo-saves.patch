-		(game.features & GF_DEMO) && memcmp(md5, demoIndex, sizeof(demoIndex)) == 0 &&
-		scummwebIsPlayerControl();
+	static constexpr byte samAndMax[] = {0x04, 0x25, 0x95, 0x4a, 0x9d, 0xb5, 0xc3, 0x40,
+		0x86, 0x16, 0x72, 0x89, 0x2c, 0x3e, 0x67, 0x8d};
+	return (game.id == GID_FT && (game.features & GF_DEMO) && memcmp(md5, fullThrottle, sizeof(fullThrottle)) == 0) ||
+		(game.id == GID_SAMNMAX && memcmp(md5, samAndMax, sizeof(samAndMax)) == 0);
 }
 
