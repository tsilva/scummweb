 void Util::waitEndFrame(bool handleInput) {
+#ifdef __EMSCRIPTEN__
+	// These original Geisha animation frames do not test their key result.
+	// Retain their script cycles, with bounded native input and redraw yields.
+	if (_browserGeishaOpening && _browserGeishaIntroSkipped &&
+			(_vm->isCurrentTot("intro.tot") || _vm->isCurrentTot("intro2.tot"))) {
