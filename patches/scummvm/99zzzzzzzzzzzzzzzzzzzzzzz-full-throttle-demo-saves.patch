+// The English DOS demo leaves its original menu disabled during play.
+static bool hasFullThrottleDemoPlayerSaves(const GameSettings &game, const byte *md5) {
+	static const byte demoIndex[] = {0x32, 0xa4, 0x33, 0xde, 0xa5, 0x6b, 0x86, 0xa5,
+		0x5b, 0x59, 0xe4, 0xff, 0x7d, 0x75, 0x57, 0x11};
+	return game.id == GID_FT && game.platform == Common::kPlatformDOS &&
+		(game.features & GF_DEMO) && memcmp(md5, demoIndex, sizeof(demoIndex)) == 0 &&
+		scummwebIsPlayerControl();
+}
