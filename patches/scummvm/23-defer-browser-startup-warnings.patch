diff --git a/engines/scummweb-startup.h b/engines/scummweb-startup.h
new file mode 100644
--- /dev/null
+++ b/engines/scummweb-startup.h
@@ -0,0 +1,29 @@
+#ifndef ENGINES_SCUMMWEB_STARTUP_H
+#define ENGINES_SCUMMWEB_STARTUP_H
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#endif
+
+#include "common/str.h"
+#include "common/ustr.h"
+
+namespace ScummWebStartup {
+
+inline bool deferCompatibilityWarning(const Common::U32String &message) {
+#ifdef __EMSCRIPTEN__
+	const Common::String text = message.encode(Common::kUtf8);
+	return EM_ASM_INT({
+		if (typeof globalThis.__scummwebPostCompatibilityWarning !== 'function')
+			return 0;
+		globalThis.__scummwebPostCompatibilityWarning(UTF8ToString($0));
+		return 1;
+	}, text.c_str());
+#else
+	return false;
+#endif
+}
+
+} // End of namespace ScummWebStartup
+
+#endif
