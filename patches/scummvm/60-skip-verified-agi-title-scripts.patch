+	// guards before advancing. Other controllers retain their ordinary input.
+	if (!state->testResult && p[0] == 20 && vm->getGameID() == GID_MH2 &&
+		vm->isBrowserOpeningRoom() && state->_curLogic == &state->logics[room] &&
+		!vm->getFlag(21) && (room == 153 || !vm->getFlag(20)))
+		state->testResult = vm->wantsBrowserOpeningKey();
+#endif
 }
 
