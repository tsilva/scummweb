+#ifdef __EMSCRIPTEN__
+bool AgiEngine::isBrowserOpeningRoom() {
+	if (!ScummWebIntro::nativeSkipEnabled() || ScummWebIntro::startupFinished())
+		return false;
+
+	const char *md5 = getGameMD5();
+	if (!md5)
+		return false;
+	const int room = getVar(VM_VAR_CURRENT_ROOM);
+	switch (getGameID()) {
+	case GID_SQ1:
+		return room == 67 && strcmp(md5, "0b216d931e95750f1f4837d6a4b821e5") == 0;
+	case GID_SQ2:
+		return (room == 140 || room == 1) && strcmp(md5, "28add5125484302d213911df60d2aded") == 0;
+	case GID_KQ2:
+		return room == 97 && strcmp(md5, "b866f0fab2fad91433a637a828cfa410") == 0;
+	case GID_GOLDRUSH:
+		return room == 73 && strcmp(md5, "a1d4de3e75c2688c1e2ca2634ffc3bd8") == 0;
+	case GID_PQ1:
+		return room == 1 && strcmp(md5, "cfa93e5f2aa7378bddd10ad6746a2ffb") == 0;
+	case GID_BC:
+		return room == 67 && strcmp(md5, "0c5a9acbcc7e51127c34818e75806df6") == 0;
+	case GID_MH2:
+		return (room == 153 || room == 154) && strcmp(md5, "b412e8a126368b76696696f7632d4c16") == 0;
+	default:
+		return false;
+	}
+}
+
+bool AgiEngine::wantsBrowserOpeningKey() {
+	const int room = getVar(VM_VAR_CURRENT_ROOM);
+	if (_game.browserIntroSkippedRoom == room)
+		return false;
+	_game.checkedIntroKey = true;
+
+	const bool continuing =
+		(getGameID() == GID_SQ2 && _game.browserIntroSkippedRoom == 140 && room == 1) ||
+		(getGameID() == GID_MH2 && _game.browserIntroSkippedRoom == 153 && room == 154);
+	if (!continuing && !ScummWebIntro::skipRequested())
+		return false;
+
+	_game.browserIntroSkippedRoom = room;
+	ScummWebIntro::skipRequested(false);
+	return true;
+}
+#endif
