diff --git a/engines/sci/sci.cpp b/engines/sci/sci.cpp
--- a/engines/sci/sci.cpp
+++ b/engines/sci/sci.cpp
@@ -903,6 +903,30 @@
 bool SciEngine::isDemo() const {
 	return _gameDescription->flags & ADGF_DEMO;
 }
+
+#ifdef __EMSCRIPTEN__
+bool scummwebSupportsSci32DemoSaves(const SciEngine &engine) {
+	if (!engine.isDemo() || !scummweb_agent_game_loop_enabled())
+		return false;
+
+	const ADGameFileDescription &signature = engine._gameDescription->filesDescriptions[0];
+	switch (engine.getGameId()) {
+	case GID_SHIVERS:
+		return ConfMan.get("extra").equalsIgnoreCase("Demo");
+	case GID_SQ6:
+		return signature.md5 && strcmp(signature.md5, "368f07b07433db3f819fa3fa0e5efee5") == 0;
+	case GID_TORIN:
+		return signature.md5 && strcmp(signature.md5, "9a3e172cde9963d0a969f26469318cec") == 0;
+	case GID_LIGHTHOUSE:
+		return signature.md5 && strcmp(signature.md5, "3bdee7a16926975a4729f75cf6b80a92") == 0;
+	case GID_LSL7:
+		return signature.md5 && strcmp(signature.md5, "5cc6159688b2dc03790a67c90ccc67f9") == 0 &&
+			signature.fileSize == 10195878;
+	default:
+		return false;
+	}
+}
+#endif
 
 bool SciEngine::isCD() const {
 	return _gameDescription->flags & ADGF_CD;
