+#ifdef __EMSCRIPTEN__
+Common::String AgosMetaEngine::getSavegameFile(int slot, const char *target) const {
+	// AGOS writes the edition's fixed filename even when autodetection gave
+	// the imported copy a different target name. Ask the running engine so
+	// the drawer and the native game use exactly the same slot filenames.
+	if (g_engine && g_engine->getMetaEngine() == this &&
+			(!target || ConfMan.getActiveDomainName() == target)) {
+		const bool pattern = slot == kSavegameFilePattern;
+		Common::String name = g_engine->getSaveStateName(pattern ? 0 : slot);
+		if (!pattern)
+			return name;
+		if (name.hasSuffix(".000")) {
+			name.replace(name.size() - 3, 3, "###");
+			return name;
+		}
+	}
+	return MetaEngine::getSavegameFile(slot, target);
+}
+#endif
