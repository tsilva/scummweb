diff --git a/engines/agos/saveload.cpp b/engines/agos/saveload.cpp
--- a/engines/agos/saveload.cpp
+++ b/engines/agos/saveload.cpp
@@ -110,6 +110,75 @@
 Common::String AGOSEngine::genSaveName(int slot) const {
 	return Common::String::format("pn.%.3d", slot);
 }
+
+#if defined(__EMSCRIPTEN__) && defined(ENABLE_AGOS2)
+namespace {
+constexpr int kOpenOracle = 60;
+constexpr int kCloseOracle = 63;
+constexpr int kOracleOpen = 99;
+
+template<size_t N>
+bool hasOracleRoutine(const Subroutine *sub, uint16 id, const byte (&prefix)[N]) {
+	for (; sub; sub = sub->next) {
+		if (sub->id == id && sub->first) {
+			const byte *code = reinterpret_cast<const byte *>(sub) + sub->first + SUBROUTINE_LINE_SMALL_SIZE;
+			return memcmp(code, prefix, N) == 0;
+		}
+	}
+	return false;
+}
+}
+
+bool AGOSEngine_Feeble::supportsOraclePlayerSaves() const {
+	if (getFeatures() & GF_DEMO || getPlatform() != Common::kPlatformAmiga ||
+			getLanguage() != Common::EN_ANY)
+		return false;
+
+	// The original ORACLE prepares a snapshot and rebuilds the room after
+	// reading it. Only use the known callbacks in this detected release.
+	static const byte openOracle[] = {0x9c, 0x0b, 0x63, 0x75, 0x93, 0x00, 0x17};
+	static const byte closeOracle[] = {0x9c, 0x47, 0x45, 0xff};
+	return hasOracleRoutine(_subroutineListOrg, kOpenOracle, openOracle) &&
+		hasOracleRoutine(_subroutineListOrg, kCloseOracle, closeOracle);
+}
+
+bool AGOSEngine_Feeble::canSaveGameStateCurrently(Common::U32String *msg) {
+	return hasFeature(kSupportsSavingDuringRuntime) && AGOSEngine::canSaveGameStateCurrently(msg) &&
+		!_clockStopped && !_interactiveVideo && !_scrollCount && readVariable(99) &&
+		!getBitFlag(9) && !getBitFlag(11) && !getBitFlag(71) &&
+		!getBitFlag(77) && !getBitFlag(78) && !getBitFlag(kOracleOpen);
+}
+
+Common::Error AGOSEngine_Feeble::saveGameState(int slot, const Common::String &desc, bool isAutosave) {
+	if (isAutosave || slot < 1 || slot > kLastOracleSaveSlot || !canSaveGameStateCurrently())
+		return Common::kWritingFailed;
+
+	startSubroutine(getSubroutineByID(kOpenOracle));
+	if (!getBitFlag(kOracleOpen) || shouldQuit())
+		return Common::kWritingFailed;
+
+	char caption[100] = {};
+	Common::strlcpy(caption, desc.c_str(), sizeof(caption));
+	bool saved = saveGame(slot, caption);
+	startSubroutine(getSubroutineByID(kCloseOracle));
+	return saved ? Common::kNoError : Common::kWritingFailed;
+}
+
+Common::Error AGOSEngine_Feeble::loadGameState(int slot) {
+	if (slot < 0 || slot > kLastOracleSaveSlot || !canLoadGameStateCurrently())
+		return Common::kReadingFailed;
+
+	startSubroutine(getSubroutineByID(kOpenOracle));
+	if (!getBitFlag(kOracleOpen) || shouldQuit())
+		return Common::kReadingFailed;
+
+	const bool loaded = loadGame(genSaveName(slot));
+	if (loaded)
+		off_checkCD();
+	startSubroutine(getSubroutineByID(kCloseOracle));
+	return loaded ? Common::kNoError : Common::kReadingFailed;
+}
+#endif
 
