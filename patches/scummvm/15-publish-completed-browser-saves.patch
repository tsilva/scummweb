+static void scummwebFinishSave(const Common::String &name, bool success) {
+	const bool refresh = EM_ASM_INT({
+		return globalThis.__scummwebEndSaveWrite ? globalThis.__scummwebEndSaveWrite(UTF8ToString($0), !!$1) : 0;
+	}, name.c_str(), success);
+	if (refresh)
+		scummweb_refresh_saves();
+}
+
+// Covers original engine dialogs and autosaves, including engines that delete
+// their stream without finalize(). Report only after compressed output AND the
+// underlying BrowserFS descriptor have closed, never from inside FS.close.
+class ScummwebSaveFile : public Common::OutSaveFile {
+	Common::String _name;
+public:
+	ScummwebSaveFile(Common::WriteStream *stream, const Common::String &name)
+		: Common::OutSaveFile(stream), _name(name) {}
+	~ScummwebSaveFile() override {
+		bool success = !_wrapped->err();
+		_wrapped->finalize();
+		success = success && !_wrapped->err();
+		delete _wrapped;
+		_wrapped = nullptr;
+		scummwebFinishSave(_name, success);
+	}
+};
+#endif
+
