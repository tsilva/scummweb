-				_agentRestoreScript = kRoomEntry;
+	// The CD scripts call a room-entry function with the saved room (variable
+	// 7). The English full CD and interactive CD demo move that function to
+	// different object IDs but use the same native save format.
+	if (getGameID() == GID_RTZ && getVersion() == 3) {
+		const int16 main = _dat->getMainCodeObjectIndex();
+		if (main == 0x01cb || main == 0x01c9 || main == 0x01c3) {
+			const int16 roomEntry = main - 8;
+			static const byte entrySignature[] = {44, 1, 6, 40, 0, 23, 85, 0};
+			if (_dat->getObjectCount() >= uint(main)) {
+				Object *entry = _dat->getObject(roomEntry);
+				if (entry && entry->getClass() == 0x7fff && entry->getSize() >= sizeof(entrySignature) &&
+						memcmp(entry->getData(), entrySignature, sizeof(entrySignature)) == 0) {
+					_agentRestoreScript = roomEntry;
+					// The F2/F3 handlers store the active room on the menu
+					// object before entering it. Match those assignments.
+					Object *program = _dat->getObject(main);
+					const uint offset = main == 0x01cb ? 700 : 611;
+					const int16 saveRoom = main == 0x01c3 ? 455 : (main == 0x01c9 ? 461 : 469);
+					const byte returnProperty = main == 0x01cb ? 23 : 25;
+					byte setReturnRoom[] = {19, byte(saveRoom), 1, 6, 19, returnProperty, 0, 6, 20, 7, 0, 22};
+					constexpr uint loadOffset = 129;
+					if (program && program->getClass() == 0x7fff && program->getSize() >= offset + loadOffset + sizeof(setReturnRoom) &&
+							memcmp(program->getData() + offset, setReturnRoom, sizeof(setReturnRoom)) == 0) {
+						++setReturnRoom[1];
+						if (memcmp(program->getData() + offset + loadOffset, setReturnRoom, sizeof(setReturnRoom)) == 0) {
+							_rtzSaveMenuRoom = saveRoom;
+							_rtzLoadMenuRoom = saveRoom + 1;
+							_rtzMenuReturnProperty = returnProperty;
+						}
+					}
+					if (!_rtzSaveMenuRoom && main != 0x01cb)
+						_agentRestoreScript = 0;
+				}
+			}
 		}
 	}
 #endif
