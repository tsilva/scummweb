 	_eventNum = _eventKey = 0;
@@ -548,16 +567,40 @@
 	_eventNum = _eventKey = _eventMouseX = _eventMouseY = 0;
 
 #ifdef __EMSCRIPTEN__
-	// This CD edition invokes the room-entry function after its native load.
-	// Match the entry signature before calling it through the host.
-	if (getGameID() == GID_RTZ && getVersion() == 3 && _dat->getMainCodeObjectIndex() == 0x01cb) {
-		static constexpr int16 kRoomEntry = 0x01c3;
-		static const byte kEntrySignature[] = {44, 1, 6, 40, 0, 23, 85, 0};
-		if (_dat->getObjectCount() >= kRoomEntry) {
-			Object *entry = _dat->getObject(kRoomEntry);
