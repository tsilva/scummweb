+	return _scummWebDecisionBoundary;
+}
+
+Common::Error PlumbersGame::saveGameStream(Common::WriteStream *stream, bool isAutosave) {
+	if (isAutosave || !canSaveGameStateCurrently())
+		return Common::kWritingFailed;
+	stream->writeUint32BE(MKTAG('P', 'L', 'M', '1'));
+	stream->writeUint16LE(_curSceneIdx);
+	stream->writeUint16LE(_prvSceneIdx);
+	stream->writeSint32LE(_totScore);
+	return stream->err() ? Common::kWritingFailed : Common::kNoError;
+}
+
+Common::Error PlumbersGame::loadGameStream(Common::SeekableReadStream *stream) {
+	if (!canLoadGameStateCurrently() || stream->size() < 12 || stream->readUint32BE() != MKTAG('P', 'L', 'M', '1'))
+		return Common::kReadingFailed;
+	const int scene = stream->readUint16LE();
+	const int previous = stream->readUint16LE();
+	const int32 score = stream->readSint32LE();
+	if (stream->err() || scene >= _totScene || previous >= _totScene ||
+			_scenes[scene]._decisionChoices <= 1 || _scenes[scene]._style == Scene::STYLE_VIDEO)
+		return Common::kReadingFailed;
+
+	stopSound();
+	_curSceneIdx = scene;
+	_prvSceneIdx = previous;
+	_totScore = score;
+	_curChoice = 0;
+	_curBitmapIdx = _scenes[scene]._startBitmap + _scenes[scene]._bitmapNum;
+	postSceneBitmaps();
+	_actions.push(Redraw);
+	return Common::kNoError;
+}
+#endif
 
