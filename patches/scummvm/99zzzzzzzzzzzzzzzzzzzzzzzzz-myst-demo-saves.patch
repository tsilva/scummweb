+#ifdef __EMSCRIPTEN__
+static constexpr uint32 kMystDemoSaveTag = MKTAG('M', 'Y', 'D', '1');
+
+bool MystDemoSave::supports(const Common::String &gameId, const Common::String &extra) {
+	return gameId == "myst" && extra.equalsIgnoreCase("Demo");
+}
+
+uint16 MystDemoSave::maxBookPages(uint16 card) {
+	switch (card) {
+	case 4047: return 12;
+	case 4059: return 150;
+	case 4060: return 8;
+	case 4068: return 13;
+	case 4080: return 14;
+	default: return 0;
+	}
+}
+
+bool MystDemoSave::read(Common::SeekableReadStream &stream) {
+	if (stream.readUint32BE() != kMystDemoSaveTag)
+		return false;
+	card = stream.readUint16LE();
+	returnCard = stream.readUint16LE();
+	bookPage = stream.readUint16LE();
+	towerAngle = stream.readUint16LE();
+	bookcaseDoor = stream.readByte();
+	redPages = stream.readByte();
+	bluePages = stream.readByte();
+	heldPage = stream.readByte();
+	const uint16 pageCount = maxBookPages(card);
+	return stream.read(fireplaceRows, sizeof(fireplaceRows)) == sizeof(fireplaceRows) &&
+		!stream.err() && !stream.eos() && card >= 4035 && card <= 4396 &&
+		returnCard >= 4035 && returnCard <= 4396 && towerAngle < 360 &&
+		bookcaseDoor <= 1 && redPages <= 127 && bluePages <= 127 &&
+		heldPage <= kWhitePage && (pageCount ? bookPage < pageCount : bookPage == 0);
+}
+
+bool MystDemoSave::write(Common::WriteStream &stream) const {
+	stream.writeUint32BE(kMystDemoSaveTag);
+	stream.writeUint16LE(card);
+	stream.writeUint16LE(returnCard);
+	stream.writeUint16LE(bookPage);
+	stream.writeUint16LE(towerAngle);
+	stream.writeByte(bookcaseDoor);
+	stream.writeByte(redPages);
+	stream.writeByte(bluePages);
+	stream.writeByte(heldPage);
+	return stream.write(fireplaceRows, sizeof(fireplaceRows)) == sizeof(fireplaceRows) && !stream.err();
+}
+
+bool MohawkEngine_Myst::hasDemoSaveSupport() const {
+	const char *signature = _gameDescription->desc.filesDescriptions[0].md5;
+	return scummwebIsPlayerControl() && isGameVariant(GF_DEMO) &&
+		MystDemoSave::supports(getGameId(), ConfMan.get("extra")) &&
+		signature && strcmp(signature, "8ff8ae264f759ea4a79cc915757f17c4") == 0;
+}
+
+Common::Error MohawkEngine_Myst::saveGameStream(Common::WriteStream *stream, bool isAutosave) {
+	if (!hasDemoSaveSupport() || !canSaveGameStateCurrently())
+		return Common::kWritingFailed;
+	MystDemoSave save;
+	static_cast<const MystStacks::Preview *>(_stack.get())->fillDemoSave(save);
+	return save.write(*stream) ? Common::kNoError : Common::kWritingFailed;
+}
+
+Common::Error MohawkEngine_Myst::loadGameStream(Common::SeekableReadStream *stream) {
+	MystDemoSave save;
+	MohawkArchive library;
+	if (!hasDemoSaveSupport() || !save.read(*stream) ||
+		!library.openFile(Common::Path("sneak.dat")) || !library.hasResource(ID_VIEW, save.card) ||
+		!library.hasResource(ID_VIEW, save.returnCard))
+		return Common::kReadingFailed;
+
+	if (_card) {
+		_card->leave();
+		_card.reset();
+	}
+	_gameState->_globals.currentAge = kMystLibrary;
+	_gameState->_globals.heldPage = static_cast<HeldPage>(save.heldPage);
+	_gameState->_globals.bluePagesInBook = save.bluePages;
+	_gameState->_globals.redPagesInBook = save.redPages;
+	_gameState->_myst.libraryBookcaseDoor = save.bookcaseDoor;
+	_gameState->_myst.towerRotationAngle = save.towerAngle;
+	changeToStack(kDemoPreviewStack, save.card, 0, 0);
+	static_cast<MystStacks::Preview *>(_stack.get())->restoreDemoSave(save);
+
+	uint16 cursor = kDefaultMystCursor;
+	if (save.heldPage >= kBlueLibraryPage && save.heldPage <= kBlueFirePlacePage)
+		cursor = kBluePageCursor;
+	else if (save.heldPage >= kRedLibraryPage && save.heldPage <= kRedFirePlacePage)
+		cursor = kRedPageCursor;
+	else if (save.heldPage == kWhitePage)
+		cursor = kWhitePageCursor;
+	setMainCursor(cursor);
+	_cursor->showCursor();
+	return Common::kNoError;
+}
