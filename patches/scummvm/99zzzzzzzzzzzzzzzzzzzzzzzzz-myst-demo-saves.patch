+void Preview::fillDemoSave(MystDemoSave &save) const {
+	save.card = _vm->getCard()->getId();
+	save.returnCard = _savedCardId;
+	if (MystDemoSave::maxBookPages(save.card))
+		save.bookPage = _libraryBookPage;
+	if (save.card == 4162) {
+		for (uint i = 0; i < ARRAYSIZE(_fireplaceLines); ++i)
+			save.fireplaceRows[i] = _fireplaceLines[i];
+	}
+	save.bookcaseDoor = _state.libraryBookcaseDoor;
+	save.towerAngle = _state.towerRotationAngle;
+	save.redPages = _globals.redPagesInBook;
+	save.bluePages = _globals.bluePagesInBook;
+	save.heldPage = _globals.heldPage;
+}
+
+void Preview::restoreDemoSave(const MystDemoSave &save) {
+	_savedCardId = save.returnCard;
+	if (save.bookPage) {
+		_libraryBookPage = save.bookPage;
+		_vm->_gfx->copyImageToScreen(_libraryBookBaseImage + _libraryBookPage, Common::Rect(544, 333));
+	}
+	if (save.card == 4162) {
+		// The fireplace buttons overlay the original grid image.
+		for (uint row = 0; row < ARRAYSIZE(_fireplaceLines); ++row) {
+			_fireplaceLines[row] = save.fireplaceRows[row];
+			for (uint column = 0; column < 8; ++column) {
+				if (!(_fireplaceLines[row] & (0x80 >> column)))
+					continue;
+				int x = 173 + 26 * column;
+				int y = 168 + 25 * row;
+				_vm->_gfx->copyImageToScreen(4795, Common::Rect(x, y, x + 26, y + (row == 4 ? 26 : 27)));
+			}
+		}
+	}
+}
