+#ifdef __EMSCRIPTEN__
+// -1 queries the live value; unsupported games cannot hide their only text.
+extern "C" EMSCRIPTEN_KEEPALIVE int scummweb_player_subtitles(int enabled) {
+	if (!g_engine || !g_engine->getMetaEngine() ||
+			!EM_ASM_INT({ return Boolean(globalThis.scummwebPlayerControls); }))
+		return -1;
+	const Common::String options = ConfMan.get("guioptions");
+	if (Common::checkGameGUIOption(GUIO_NOSUBTITLES, options) ||
+			Common::checkGameGUIOption(GUIO_NOSPEECH, options))
+		return -1;
+	if (enabled == 0 || enabled == 1) {
+		ConfMan.setBool("subtitles", enabled != 0);
+		// Disabling text must leave recorded speech available.
+		if (!enabled)
+			ConfMan.setBool("speech_mute", false);
+		g_engine->applyGameSettings();
+		g_engine->syncSoundSettings();
+	}
+	return ConfMan.getBool("subtitles") ? 1 : 0;
+}
+#endif
