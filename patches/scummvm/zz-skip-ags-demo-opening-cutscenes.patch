@@ -81,6 +83,38 @@ namespace AGS3 {
 
 using namespace AGS::Shared;
 
+#ifdef __EMSCRIPTEN__
+// The two verified demos use a native opening cutscene in their title room.
+// The menu occupies that same room, so end availability at EndCutscene.
+static bool scummwebAgsOpeningSeen = false;
+static bool scummwebAgsOpeningDone = false;
+static bool scummwebAgsOpeningEdition() {
+	if (!(::AGS::g_vm->getFeatures() & ADGF_DEMO))
+		return false;
+	const auto gameId = ::AGS::g_vm->getGameId();
+	return (gameId == "primordia" && _GP(game).uniqueid == 263302343 && _G(displayed_room) == 27) ||
+	       (gameId == "technobabylon" && _GP(game).uniqueid == 1186933 && _G(displayed_room) == 2);
+}
+static void scummwebAgsOpeningTick() {
+	if (scummwebAgsOpeningDone || !scummwebAgsOpeningEdition())
+		return;
+	if (_GP(play).in_cutscene) {
+		scummwebAgsOpeningSeen = true;
+		const auto mode = get_cutscene_skipstyle();
+		const bool keyboard = mode == eSkipSceneAnyKey || mode == eSkipSceneKeyMouse ||
+		                      mode == eSkipSceneEscOnly || mode == eSkipSceneEscOrRMB;
+		if (ScummWebIntro::nativeSkipEnabled() && ScummWebIntro::skipRequested(keyboard)) {
+			check_skip_cutscene_keypress(eAGSKeyCodeEscape);
+			ScummWebIntro::skipRequested(false);
+			scummwebAgsOpeningDone = true;
+		}
+	} else if (scummwebAgsOpeningSeen) {
+		ScummWebIntro::skipRequested(false);
+		scummwebAgsOpeningDone = true;
+	}
+}
+#endif
+
 static bool ShouldStayInWaitMode();
 
