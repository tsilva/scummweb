+#include "engines/scummweb-intro.h"
+
 namespace Sword25 {
 
 // Marks a function that should never be used
@@ -237,6 +239,40 @@ static int setWidth(lua_State *L) {
 	return 0;
 }
 
+#ifdef __EMSCRIPTEN__
+static bool introHasEnded(lua_State *L) {
+	const int top = lua_gettop(L);
+	// Aps is Nico's landing. The preceding apartment conversation can render
+	// ordinary game frames while the script keeps the interface disabled.
+	lua_getglobal(L, "CurrentRoom");
+	lua_getglobal(L, "Rooms");
+	if (!lua_istable(L, -1) || !lua_istable(L, -2)) {
+		lua_settop(L, top);
+		return false;
+	}
+	lua_getfield(L, -1, "Aps");
+	const bool onLanding = lua_rawequal(L, -1, -3);
+	lua_settop(L, top);
+	if (!onLanding)
+		return false;
+
+	// GetMode simply returns its sole upvalue in the bundled interface.lua.
+	// Read it directly so observing the transition never runs game scripts.
+	lua_getglobal(L, "Interface");
+	bool acceptsInput = false;
+	if (lua_istable(L, -1)) {
+		lua_getfield(L, -1, "GetMode");
+		if (lua_isfunction(L, -1)) {
+			const char *upvalue = lua_getupvalue(L, -1, 1);
+			const char *mode = upvalue ? lua_tostring(L, -1) : nullptr;
+			acceptsInput = mode && !strcmp(mode, "default");
+		}
+	}
+	lua_settop(L, top);
+	return acceptsInput;
+}
+#endif
