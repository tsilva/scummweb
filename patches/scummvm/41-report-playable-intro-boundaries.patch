+ * Distributed under the GNU General Public License, version 3 or later.
+ */
+#ifndef ENGINES_SCUMMWEB_INTRO_H
+#define ENGINES_SCUMMWEB_INTRO_H
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+namespace ScummWebIntro {
+
+// One transition per game frame document. The shell owns the player UI.
+inline void gameplayStarted() {
+	static bool reported = false;
+	if (reported)
+		return;
+	reported = true;
+	EM_ASM({ globalThis.__scummwebReportGameplayStarted?.(); });
+}
+
+} // namespace ScummWebIntro
+#endif
+
+#endif
