+
+void MinigameBbLoogie::saveRound(Common::WriteStream &out) {
+	out.writeUint32BE(kLoogieRoundTag);
+	out.writeUint32LE(_vm->_random->getSeed());
+	out.writeByte(_playerKind);
+	out.writeByte(_squirrelDirection);
+	out.writeByte(_principalAngry);
+	for (int value : {_levelTimeLeft, _levelTimeDelay, _numberOfHits, _currScore, _doubleScore,
+			_megaLoogieCount, _carDelay, _bikeDelay, _squirrelDelay, _paperPlaneDelay, _principalDelay,
+			_prevPrincipalStatus, _principalCtr, _principalFirstFrameIndex, _principalLastFrameIndex})
+		out.writeSint32LE(value);
+
+	for (const auto &obj : _objects) {
+		out.writeByte(obj.kind);
+		if (!obj.kind)
+			continue;
+		for (int value : {obj.x, obj.y, obj.xIncr, obj.yIncr, obj.frameIndex, obj.ticks, obj.status})
+			out.writeSint32LE(value);
+		out.writeSint16LE(obj.frameIndexAdd);
+		out.writeSint16LE(obj.unk2);
+	}
+}
+
+bool MinigameBbLoogie::loadRound(Common::SeekableReadStream &in) {
+	if (in.readUint32BE() != kLoogieRoundTag)
+		return false;
+	const uint32 seed = in.readUint32LE();
+	const byte player = in.readByte();
+	const byte squirrelDirection = in.readByte();
+	const byte principalAngry = in.readByte();
+	int values[15];
+	for (int &value : values) {
+		value = in.readSint32LE();
+		if (value < -1000000 || value > 1000000)
+			return false;
+	}
+	if (in.err() || player > 1 || squirrelDirection > 1 || principalAngry > 1 ||
+		values[1] < 1 || values[1] > 58 || values[2] < 0 || values[2] > 1000 ||
+		values[3] < 0 || (values[4] != 0 && values[4] != 17) || values[5] < 0 || values[5] > 11)
+		return false;
+	const int principalFrames = getAnimation(18)->frameCount;
+	if (values[13] < 0 || values[13] >= principalFrames ||
+		values[14] < 0 || values[14] >= principalFrames)
+		return false;
+
+	Obj objects[kMaxObjectsCount] = {};
+	const int animations[] = {-1, player, 4, 5, 2, 3, 7, 16, 17, 18};
+	int active = 0;
+	for (int index = 0; index < kMaxObjectsCount; ++index) {
+		Obj &obj = objects[index];
+		obj.kind = in.readByte();
+		if (!obj.kind)
+			continue;
+		if (obj.kind >= ARRAYSIZE(animations) ||
+			(obj.kind <= 2 && obj.kind != index + 1) || ++active > kMaximumRoundObjects)
+			return false;
+		obj.anim = getAnimation(animations[obj.kind]);
+		for (int *value : {&obj.x, &obj.y, &obj.xIncr, &obj.yIncr, &obj.frameIndex, &obj.ticks, &obj.status}) {
+			*value = in.readSint32LE();
+			if (*value < -1000000 || *value > 1000000)
+				return false;
+		}
+		obj.frameIndexAdd = in.readSint16LE();
+		obj.unk2 = in.readSint16LE();
+		if (obj.frameIndex < 0 || obj.frameIndex >= obj.anim->frameCount)
+			return false;
+		if ((obj.kind == 1 || obj.kind == 3) && (obj.unk2 < 0 || obj.unk2 > 61))
+			return false;
+		if (obj.kind == 1 && (obj.status < 0 || obj.status > 3 ||
+			(obj.status == 1 && (obj.frameIndex < 14 || obj.frameIndex > 15)) ||
+			(obj.status == 2 && (obj.frameIndex < 16 || obj.frameIndex > 17)) ||
+			(obj.status == 3 && (obj.frameIndex < 21 || obj.frameIndex > 23))))
+			return false;
+		if (obj.kind == 3 && (obj.frameIndex > 16 ||
+			(obj.frameIndexAdd != 0 && obj.frameIndexAdd != 17) ||
+			obj.frameIndex + obj.frameIndexAdd >= obj.anim->frameCount))
+			return false;
+	}
+	if (in.err() || in.eos() || in.pos() != in.size() ||
+		objects[0].kind != 1 || objects[1].kind != 2)
+		return false;
+
+	selectRoundPlayer(player);
+	_squirrelDirection = squirrelDirection;
+	_principalAngry = principalAngry;
+	int *fields[] = {&_levelTimeLeft, &_levelTimeDelay, &_numberOfHits, &_currScore, &_doubleScore,
+		&_megaLoogieCount, &_carDelay, &_bikeDelay, &_squirrelDelay, &_paperPlaneDelay, &_principalDelay,
+		&_prevPrincipalStatus, &_principalCtr, &_principalFirstFrameIndex, &_principalLastFrameIndex};
+	static_assert(ARRAYSIZE(values) == ARRAYSIZE(fields), "Round fields must match serialized values");
+	for (uint i = 0; i < ARRAYSIZE(values); ++i)
+		*fields[i] = values[i];
+	memcpy(_objects, objects, sizeof(_objects));
+	_gameState = kGSMainGame;
+	_gameResult = _principalAngry;
+	_gameDone = false;
+	_gameTicks = _vm->_system->getMillis();
+	_vm->_mouseButtons = 0;
+	_vm->_customAction = kActionNone;
+	_vm->_random->setSeed(seed);
+	drawSprites();
+	return true;
+}
