+#ifdef __EMSCRIPTEN__
+bool PegasusEngine::supportsScummWebDemoSaves() const {
+	return _targetName == "pegasus-demo" && isOldDemo() &&
+		_gameDescription->desc.platform == Common::kPlatformMacintosh &&
+		_gameDescription->desc.filesDescriptions[0].fileSize == 359873;
+}
+
+bool PegasusEngine::isDemoSaveHeader(Common::SeekableReadStream &stream) {
+	if (stream.size() <= 12)
+		return false;
+	const uint32 creator = stream.readUint32BE();
+	const uint32 type = stream.readUint32BE();
+	const uint32 version = stream.readUint32BE();
+	return creator == kPegasusPrimeCreator &&
+		type >= kPegasusPrimeDisk1GameType && type <= kPegasusPrimeDisk4GameType &&
+		version == kPegasusPrimeVersion && stream.seek(0);
+}
+#endif
+
 bool PegasusEngine::canLoadGameStateCurrently(Common::U32String *msg) {
+#ifdef __EMSCRIPTEN__
+	if (_agentControlBoundary && supportsScummWebDemoSaves())
+		return _loadAllowed && g_neighborhood && g_interface;
+#endif
 	return _loadAllowed && !isDemo();
 }
 
 bool PegasusEngine::canSaveGameStateCurrently(Common::U32String *msg) {
+#ifdef __EMSCRIPTEN__
+	if (_agentControlBoundary && supportsScummWebDemoSaves())
+		return _saveAllowed && g_neighborhood && g_interface;
+#endif
 	return _saveAllowed && !isDemo() && g_neighborhood;
 }
 
