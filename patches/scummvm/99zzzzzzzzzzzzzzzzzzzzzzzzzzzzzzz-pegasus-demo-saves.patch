 SaveStateList PegasusMetaEngine::listSaves(const char *target) const {
+#ifdef __EMSCRIPTEN__
+	if (isScummWebPegasusDemoTarget(target)) {
+		SaveStateList saves;
+		auto *manager = g_system->getSavefileManager();
+		const auto files = manager->listSavefiles(getSavegameFile(kSavegameFilePattern, target));
+		for (const auto &name : files) {
+			const uint index = name.size() - 3;
+			const int slot = (name[index] - '0') * 100 + (name[index + 1] - '0') * 10 + name[index + 2] - '0';
+			Common::InSaveFile *file = manager->openForLoading(name);
+			if (file && Pegasus::PegasusEngine::isDemoSaveHeader(*file))
+				saves.push_back(SaveStateDescriptor(this, slot, Common::String::format("Save %d", slot)));
+			delete file;
+		}
+		return saves;
+	}
