@@ -0,0 +1,95 @@
+/* ScummWEB opt-in snapshots of engine-owned game state. */
+#ifndef ENGINES_SCUMMWEB_TELEMETRY_H
+#define ENGINES_SCUMMWEB_TELEMETRY_H
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#include "common/scummsys.h"
+
+namespace ScummWebTelemetry {
+
+constexpr uint kMaxBankSize = 4096;
+constexpr int32 kMissingValue = INT32_MIN;
+
+inline uint boundedCount(uint count) {
+	return count > kMaxBankSize ? kMaxBankSize : count;
+}
+
+// An adapter captures all banks at a single engine tick, before yielding
+// back to the browser. No pointers into WebAssembly memory escape the tick.
+class Sample {
+	bool _enabled;
+	uint _namedValues = 0;
+
+public:
+	explicit Sample(double room = -1, const char *name = nullptr, int ready = -1, bool force = false) {
+		_enabled = EM_ASM_INT({
+			if (!globalThis.__scummwebTelemetryQueryEnabled || !globalThis.__scummwebEvaluationGame) return 0;
+			const now = performance.now();
+			const previous = globalThis.__scummwebGameTelemetry;
+			const name = $1 ? UTF8ToString($1) : undefined;
+			const ready = $2 < 0 ? undefined : Boolean($2);
+			if (!$3 && previous && previous.room_id === ($0 < 0 ? null : $0) && previous.room_name === name &&
+				previous.room_ready === ready && now - previous.sample_time_ms < 250) return 0;
+			globalThis.__scummwebTelemetrySample = ({
+				schema_version: 1,
+				room_id: $0 < 0 ? null : $0,
+				room_name: name,
+				room_ready: ready,
+				sample_time_ms: now,
+				banks: Object.create(null)
+			});
+			return 1;
+		}, room, name, ready, force);
+	}
+
+	Sample(const Sample &) = delete;
+	Sample &operator=(const Sample &) = delete;
+
+	explicit operator bool() const { return _enabled; }
+
+	~Sample() {
+		if (_enabled) {
+			EM_ASM({
+				globalThis.__scummwebGameTelemetry = globalThis.__scummwebTelemetrySample;
+				globalThis.__scummwebTelemetrySample = null;
+			});
+		}
+	}
+
+	// For engines with named or sparse variables. Keep source keys intact.
+	void variable(const char *bank, const char *key, double value) {
+		if (!_enabled || _namedValues == kMaxBankSize)
+			return;
+		++_namedValues;
+		EM_ASM({
+			const bank = UTF8ToString($0);
+			const staging = globalThis.__scummwebTelemetrySample;
+			const values = staging.banks[bank] ||= Object.create(null);
+			if (Number.isFinite($2)) values[UTF8ToString($1)] = $2;
+		}, bank, key, value);
+	}
+
+	template<typename T>
+	void bank(const char *name, const T *values, uint count, bool nullable = false) const {
+		if (!_enabled || !values || !count)
+			return;
+		constexpr bool signedValues = static_cast<T>(-1) < static_cast<T>(0);
+		EM_ASM({
+			const heap = $3 === 4 ? ($4 ? HEAP32 : HEAPU32)
+				: $3 === 2 ? ($4 ? HEAP16 : HEAPU16) : ($4 ? HEAP8 : HEAPU8);
+			const start = $1 / $3;
+			const values = Array.from(heap.subarray(start, start + $2));
+			if ($5) {
+				for (let i = 0; i < values.length; ++i) {
+					if (values[i] === -2147483648) values[i] = null;
+				}
+			}
+			globalThis.__scummwebTelemetrySample.banks[UTF8ToString($0)] = values;
+		}, name, values, boundedCount(count), sizeof(T), signedValues, nullable);
+	}
+};
+
+} // namespace ScummWebTelemetry
+#endif
+#endif
