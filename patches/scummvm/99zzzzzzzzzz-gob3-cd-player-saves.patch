+const Gob3SaveLayout *Game::getGob3SaveLayout() const {
+	if (_vm->getGameType() != kGameTypeGob3 || _vm->getPlatform() != Common::kPlatformDOS ||
+			_curEnvironment < 1 || !_curTotFile.hasPrefixIgnoreCase("emap") ||
+			!_environments.getTotFile(_curEnvironment - 1).equalsIgnoreCase("menu.tot"))
+		return nullptr;
+
+	const Script *menu = _environments.getScript(_curEnvironment - 1);
+	if (!menu || menu->getVariablesCount() * 4 != kGob3SaveVarBytes)
+		return nullptr;
+
+	static const byte saveSignature[] = {1, 1, 51, 0, 128, 23, 16, 0, 36, 21, 1, 99, 1, 4, 38, 0};
+	for (const auto *layout : {&kGob3DemoLayout, &kGob3CdLayout}) {
+		if (menu->getSize() == layout->menuScriptSize &&
+				memcmp(menu->getData(layout->saveCallback), saveSignature, sizeof(saveSignature)) == 0 &&
+				memcmp(menu->getData(layout->loadCallback), layout->loadSignature, sizeof(layout->loadSignature)) == 0)
+			return layout;
+	}
+	return nullptr;
+}
+
+bool Game::isGob3CheckpointInput() const {
+	const Gob3SaveLayout *layout = getGob3SaveLayout();
+	if (!layout)
+		return false;
+	if (layout == &kGob3DemoLayout && (!_vm->isCurrentTot("emap1000.tot") ||
+			_script->getSize() != 22536 || _script->pos() != 17575))
+		return false;
+
+	// The two original scene hotspots provide the normal play input and
+	// open the native save menu. Miscellaneous dialog/input loops differ.
+	static const byte inputSignature[] = {2, 69, 1, 8, 0, 1, 0, 0, 2, 216, 1, 199, 0, 1, 0, 1};
+	const int32 pos = _script->pos();
+	return pos >= 0 && _script->getData(pos + sizeof(inputSignature) - 1) &&
+		memcmp(_script->getData(pos), inputSignature, sizeof(inputSignature)) == 0;
 }
 
