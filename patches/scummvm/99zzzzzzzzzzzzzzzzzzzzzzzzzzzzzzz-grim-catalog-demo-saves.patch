+#ifdef __EMSCRIPTEN__
+bool SaveGame::readHostedDescription(Common::String &description) {
+	if (!isCompatible())
+		return false;
+
+	while (!_inSaveFile->err() && _inSaveFile->size() - _inSaveFile->pos() >= 8) {
+		const uint32 tag = _inSaveFile->readUint32BE();
+		const uint32 size = _inSaveFile->readUint32BE();
+		if (tag == SAVEGAME_FOOTERTAG || size > _inSaveFile->size() - _inSaveFile->pos())
+			return false;
+		if (tag == MKTAG('S', 'U', 'B', 'S')) {
+			if (size < 4)
+				return false;
+			const uint32 length = _inSaveFile->readUint32LE();
+			char text[256];
+			if (length == 0 || length >= sizeof(text) || length > size - 4 ||
+				_inSaveFile->read(text, length) != length)
+				return false;
+			text[length] = 0;
+			description = text;
+			return !_inSaveFile->err();
+		}
+		if (!_inSaveFile->seek(size, SEEK_CUR))
+			return false;
+	}
+	return false;
+}
+#endif
+
 uint SaveGame::saveMajorVersion() const {
 	return _majorVersion;
 }
