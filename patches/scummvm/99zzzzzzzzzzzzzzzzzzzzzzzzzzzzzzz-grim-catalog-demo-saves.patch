+#ifdef __EMSCRIPTEN__
+Common::String GrimMetaEngine::getSavegameFile(int slot, const char *target) const {
+	if (target && ConfMan.hasGameDomain(target)) {
+		const Common::String gameId = ConfMan.get("gameid", target);
+		const bool ps2 = Common::parsePlatform(ConfMan.get("platform", target)) == Common::kPlatformPS2;
+		if (gameId == "monkey4") {
+			if (slot == kSavegameFilePattern)
+				return ps2 ? "efmi###.ps2" : "efmi###.gsv";
+			return Common::String::format(ps2 ? "efmi%03d.ps2" : "efmi%03d.gsv", slot);
+		}
+		if (gameId == "grim")
+			return slot == kSavegameFilePattern ? "grim##.gsv" : Common::String::format("grim%02d.gsv", slot);
+	}
+	return MetaEngine::getSavegameFile(slot, target);
