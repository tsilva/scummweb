 bool AGOSEngine::canLoadGameStateCurrently(Common::U32String *msg) {
+	if (getGameType() == GType_SIMON1 && getPlatform() == Common::kPlatformDOS &&
+		ConfMan.get("extra").equalsIgnoreCase("CD Demo") &&
+		EM_ASM_INT({ return Boolean(globalThis.__scummwebIsStartupLoad?.()); })) {
+		// The demo holds its cursor during the first prison scene. A saved
+		// game has already passed that opening, so wait for the original
+		// interface to render without requiring mouse input.
+		return _simon1OpeningSceneDrawn && _scummWebAgentIdle && !_copyScnFlag &&
+			!_videoLockOut && !_showPreposition && !_dragMode;
+	}
 	return canSaveGameStateCurrently(msg);
 }
 
