+// A conversation may keep running while its actors speak. Only offer Confirm
+// while the original dialog choice handler is actually accepting input.
+static void publishDialogueChoices() {
+	if (!EM_ASM_INT({ return Boolean(globalThis.__scummwebSetDialogueActive); }))
+		return;
+	lua_beginblock();
+	lua_Object handler = storyField(lua_rawgetglobal("system"), "buttonHandler");
+	const lua_Object dialog = lua_rawgetglobal("Dialog");
+	const lua_Object chooser = storyField(dialog, "buttonHandler");
+	bool active = lua_isfunction(handler) && lua_isfunction(chooser) &&
+		luaO_equalObj(luaA_Address(handler), luaA_Address(chooser));
+	// LuaBase::callback also accepts an object, passing it as self. Dialog
+	// instances inherit their choice handler through the raw parent chain.
+	for (uint depth = 0; lua_istable(handler) && depth < 16; ++depth) {
+		if (lua_istable(dialog) && luaO_equalObj(luaA_Address(handler), luaA_Address(dialog))) {
+			active = true;
+			break;
+		}
+		handler = storyField(handler, "parent");
+	}
+	lua_endblock();
+	EM_ASM({ globalThis.__scummwebSetDialogueActive(Boolean($0)); }, active);
 }
 
