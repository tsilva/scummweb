+#ifdef __EMSCRIPTEN__
+SaveStateList MadeMetaEngine::listSaves(const char *target) const {
+	SaveStateList saves;
+	if (!target || !hasFeature(kSupportsListSaves))
+		return saves;
+
+	for (const auto &filename : g_system->getSavefileManager()->listSavefiles(getSavegameFilePattern(target))) {
+		const int slot = atoi(filename.c_str() + filename.size() - 3);
+		Common::String description;
+		if (Made::GameDatabaseV3::readSavegameDescription(filename.c_str(), description, Made::kRtzSaveVersion))
+			saves.push_back(SaveStateDescriptor(this, slot, description));
+	}
+	Common::sort(saves.begin(), saves.end(), SaveStateDescriptorSlotComparator());
+	return saves;
+}
+#endif
 
 bool Made::MadeEngine::hasFeature(EngineFeature f) const {
+#ifdef __EMSCRIPTEN__
+	if (_agentRestoreScript && scummweb_agent_game_loop_enabled() &&
+			(f == kSupportsSavingDuringRuntime || f == kSupportsLoadingDuringRuntime))
+		return true;
+#endif
 	return
 		(f == kSupportsReturnToLauncher);
