+#ifdef __EMSCRIPTEN__
+static constexpr int16 kRtzRoom = 7;
+
+bool MadeEngine::canSaveGameStateCurrently(Common::U32String *msg) {
+	return _agentRestoreScript && _agentControlBoundary && _dat->getVar(kRtzRoom) > 0;
+}
+
+bool MadeEngine::canLoadGameStateCurrently(Common::U32String *msg) {
+	return canSaveGameStateCurrently(msg);
+}
+
+Common::Error MadeEngine::saveGameState(int slot, const Common::String &desc, bool isAutosave) {
+	if (!canSaveGameStateCurrently() || slot < 0 || slot > 999)
+		return Common::kWritingFailed;
+
+	const Common::String filename = getSavegameFilename(slot);
+	return _dat->savegame(filename.c_str(), desc.c_str(), kRtzSaveVersion) == 0
+		? Common::kNoError : Common::kWritingFailed;
+}
+
+Common::Error MadeEngine::loadGameState(int slot) {
+	if (!canLoadGameStateCurrently() || slot < 0 || slot > 999)
+		return Common::kReadingFailed;
+
+	const Common::String filename = getSavegameFilename(slot);
+	if (_dat->loadgame(filename.c_str(), kRtzSaveVersion) != 0)
+		return Common::kReadingFailed;
+
+	// Use the same room-entry script as the original restore menu. Its
+	// interpreter has a separate stack from the suspended event poll.
+	int16 room = _dat->getVar(kRtzRoom);
+	ScriptInterpreter restore(this);
+	restore.runScript(_agentRestoreScript, 1, &room);
+	_eventNum = _eventKey = 0;
+	return Common::kNoError;
+}
+#endif
