-ScummFile *Sound::restoreDiMUSESpeechFile(const char *fileName) {
+ScummFile *Sound::restoreDiMUSESpeechFile(const char *fileName, uint32 speechOffset) {
 	Common::ScopedPtr<ScummFile> file;
 	file.reset(_vm->instantiateScummFile());
 	if (!_vm->openFile(*file, fileName)) {
 		return NULL;
 	}
 
+#if defined(__EMSCRIPTEN__) && defined(USE_FLAC)
+	if (_vm->_game.id == GID_FT && _soundMode == kFLACMode) {
+		// A saved stream offset lies inside its original SOU record.
+		const MP3OffsetTable *entry = nullptr;
+		for (int i = 0; i < _numSoundEffects; ++i) {
+			if (_offsetTable[i].org_offset < 0 || (uint32)_offsetTable[i].org_offset > speechOffset)
+				break;
+			entry = &_offsetTable[i];
+		}
+		if (!entry || entry->new_offset < 0 || entry->num_tags < 0 ||
+				entry->num_tags > 1024 || (entry->num_tags & 1) || entry->compressed_size <= 0 ||
+				(int64)entry->new_offset + entry->num_tags + entry->compressed_size > file->size())
+			return nullptr;
+		byte tags[1024];
+		if (!file->seek(entry->new_offset) || file->read(tags, entry->num_tags) != (uint32)entry->num_tags)
+			return nullptr;
+		const uint32 start = entry->new_offset + entry->num_tags;
+		Common::ScopedPtr<Audio::SeekableAudioStream> audio(Audio::makeFLACStream(
+			new Common::SeekableSubReadStream(file.release(), start, start + entry->compressed_size,
+				DisposeAfterUse::YES), DisposeAfterUse::YES));
+		if (!audio)
+			return nullptr;
+		return makeScummWebFTSpeechFile(_vm, *audio, tags, entry->num_tags, entry->org_offset);
+	}
+#else
+	(void)speechOffset;
+#endif
 	return file.release();
 }
 
