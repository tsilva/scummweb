new file mode 100644
--- /dev/null
+++ b/engines/scumm/scummweb_ft_speech.h
@@ -0,0 +1,71 @@
+#ifndef SCUMM_SCUMMWEB_FT_SPEECH_H
+#define SCUMM_SCUMMWEB_FT_SPEECH_H
+
+#include "common/memstream.h"
+#include "audio/audiostream.h"
+#include "scumm/file.h"
+
+namespace Scumm {
+
+// A single decoded line keeps original SOU offsets, including across save/load.
+class ScummWebFTSpeechFile : public ScummFile {
+	uint32 _origin;
+public:
+	ScummWebFTSpeechFile(ScummEngine *vm, byte *data, uint32 size, uint32 origin)
+		: ScummFile(vm), _origin(origin) {
+		_baseStream.reset(new Common::MemoryReadStream(data, size, DisposeAfterUse::YES));
+	}
+	int64 pos() const override { return _origin + _baseStream->pos(); }
+	int64 size() const override { return _origin + _baseStream->size(); }
+	bool seek(int64 offset, int whence = SEEK_SET) override {
+		return _baseStream->seek(whence == SEEK_SET ? offset - _origin : offset, whence);
+	}
+};
+
+// FT's current DiMUSE consumes unsigned 8-bit VOC, not compressed AudioStreams.
+// The old SOF format retains mouth tags and lossless PCM but omits VOC headers.
+static ScummFile *makeScummWebFTSpeechFile(ScummEngine *vm, Audio::AudioStream &audio,
+		const byte *tags, uint32 tagBytes, uint32 origin) {
+	if (audio.isStereo() || (audio.getRate() != 22050 && audio.getRate() != 11025) ||
+			tagBytes > 1024 || (tagBytes & 1))
+		return nullptr;
+	Common::MemoryWriteStreamDynamic out(DisposeAfterUse::YES);
+	out.writeUint32BE(MKTAG('V', 'C', 'T', 'L'));
+	out.writeUint32BE(tagBytes + 8);
+	out.write(tags, tagBytes);
+	out.writeUint32BE(MKTAG('V', 'T', 'L', 'K'));
+	out.writeUint32BE(0); // Filled after decoding the line.
+	out.write("Creative Voice File\x1a", 20);
+	out.writeUint16LE(26);
+	out.writeUint16LE(0x010a);
+	out.writeUint16LE(0x1129);
+	out.writeUint32LE(1); // Type 1, with a three-byte length filled below.
+	out.writeByte(audio.getRate() == 22050 ? 211 : 165);
+	out.writeByte(0); // Unsigned 8-bit PCM.
+	int16 samples[4096];
+	uint32 count = 0;
+	while (!audio.endOfStream()) {
+		const int n = audio.readBuffer(samples, ARRAYSIZE(samples));
+		// Some decoders discover EOF only on the final zero-length read.
+		if (n == 0 && audio.endOfStream())
+			break;
+		if (n <= 0 || n > (int)ARRAYSIZE(samples) || count + n > 8 * 1024 * 1024)
+			return nullptr;
+		for (int i = 0; i < n; ++i)
+			out.writeByte((samples[i] + 32768) >> 8);
+		count += n;
+	}
+	if (!count)
+		return nullptr;
+	out.writeByte(0); // VOC terminator.
+	byte *data = (byte *)malloc(out.size());
+	if (!data)
+		return nullptr;
+	memcpy(data, out.getData(), out.size());
+	WRITE_BE_UINT32(data + 12 + tagBytes, 8 + 26 + 6 + count + 1);
+	WRITE_LE_UINT32(data + 16 + tagBytes + 26, ((count + 2) << 8) | 1);
+	return new ScummWebFTSpeechFile(vm, data, out.size(), origin);
+}
+
+} // namespace Scumm
+#endif
