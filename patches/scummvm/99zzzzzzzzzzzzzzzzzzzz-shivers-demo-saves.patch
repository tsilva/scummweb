--- /dev/null
+++ b/engines/sci/scummweb-demo-saves.h
@@ -0,0 +1,17 @@
+#ifndef SCI_SCUMMWEB_DEMO_SAVES_H
+#define SCI_SCUMMWEB_DEMO_SAVES_H
+
+#include "common/config-manager.h"
+#include "engines/scummweb-agent-loop.h"
+#include "sci/sci.h"
+
+namespace Sci {
+
+inline bool scummwebSupportsSci32DemoSaves(const SciEngine &engine) {
+	return engine.getGameId() == GID_SHIVERS && engine.isDemo() &&
+		ConfMan.get("extra").equalsIgnoreCase("Demo") && scummweb_agent_game_loop_enabled();
+}
+
+} // End of namespace Sci
+
+#endif
