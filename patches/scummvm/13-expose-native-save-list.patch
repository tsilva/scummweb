+#ifdef __EMSCRIPTEN__
+static const MetaEngine *scummwebMetaEngine = nullptr;
+static Common::String scummwebEngineId, scummwebGameId, scummwebTarget;
+
+// Also used by --list-saves, before an engine instance exists. Keep this on
+// ScummVM's native save API so engine filename/slot conventions remain native.
+int scummwebReportSaves(const MetaEngine &meta, const Common::String &engineId,
+		const Common::String &gameId, const Common::String &target) {
+	bool supported = meta.hasFeature(MetaEngine::kSupportsListSaves) &&
+		meta.hasFeature(MetaEngine::kSupportsLoadingDuringStartup);
+	if (engineId == "agi" && (gameId == "mickey" || gameId == "winnie" || gameId == "troll"))
+		supported = false;
+	if (engineId == "mohawk" && gameId != "myst" && gameId != "riven")
+		supported = false;
+	Common::String extra = ConfMan.get("extra");
+	extra.toLowercase();
+	if (engineId == "mohawk" && extra.contains("demo"))
+		supported = false;
+	EM_ASM({ if (globalThis.__scummwebBeginSaveScan) globalThis.__scummwebBeginSaveScan(UTF8ToString($0), UTF8ToString($1), UTF8ToString($2), $3, UTF8ToString($4)); },
+		engineId.c_str(), gameId.c_str(), target.c_str(), supported, extra.c_str());
+	if (supported) {
+		const SaveStateList saves = meta.listSaves(target.c_str());
+		for (const auto &save : saves) {
+			const int slot = save.getSaveSlot();
+			if (slot < 0 || slot > meta.getMaximumSaveSlot() || save.getLocked())
+				continue;
+			// These are restart checkpoints, not player progress.
+			if (engineId == "kyra" && slot == 0 && (gameId == "kyra1" || gameId == "kyra2" || gameId == "kyra3"))
+				continue;
+			if (meta.hasFeature(MetaEngine::kSavesSupportMetaInfo) &&
+				meta.querySaveMetaInfos(target.c_str(), slot).getSaveSlot() < 0)
+				continue;
+			// These engines deliberately use a fixed prefix across targets.
+			const char *prefix = (engineId == "lure" || engineId == "queen" || engineId == "tony")
+				? engineId.c_str() : target.c_str();
+			const Common::String filename = meta.getSavegameFile(slot, prefix);
+			Common::InSaveFile *file = g_system->getSavefileManager()->openForLoading(filename);
+			const bool exists = file && file->size() > 0;
+			delete file;
+			// SCI, Cine and Pegasus can list a nonexistent autosave placeholder.
+			if (exists)
+				EM_ASM({ if (globalThis.__scummwebAddSave) globalThis.__scummwebAddSave($0, UTF8ToString($1)); }, slot, filename.c_str());
+		}
+	}
+	return EM_ASM_INT({ return globalThis.__scummwebEndSaveScan ? globalThis.__scummwebEndSaveScan() : -1; });
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void scummweb_refresh_saves() {
+	if (scummwebMetaEngine)
+		scummwebReportSaves(*scummwebMetaEngine, scummwebEngineId, scummwebGameId, scummwebTarget);
+}
