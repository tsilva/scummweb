+bool Gob::GobEngine::matchesGob3CheckpointTarget(const char *target) const {
+	return _targetName == target && getGameType() == kGameTypeGob3 &&
+		((_extra && isGob3CheckpointEdition(_extra, getPlatform())) ||
+		(_game && _game->hasAgentCheckpointScript()));
+}
+
 Common::String Gob::GobEngine::getSaveStateName(int slot) const {
