+bool GobMetaEngine::isGob3CheckpointTarget(const Common::String &target) const {
+	// Auto-detected imports can have an active target without the edition
+	// fields of a configured launcher target.
+	if (g_engine && g_engine->getMetaEngine() == this &&
+			static_cast<const Gob::GobEngine *>(g_engine)->matchesGob3CheckpointTarget(target.c_str()))
+		return true;
+
+	return ConfMan.hasGameDomain(target) && ConfMan.get("gameid", target) == "gob3" &&
+		isGob3CheckpointEdition(ConfMan.get("extra", target), Common::parsePlatform(ConfMan.get("platform", target)));
+}
