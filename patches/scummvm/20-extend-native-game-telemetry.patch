+}
+
+static lua_Object storyIndex(lua_Object table, int index) {
+	if (!lua_istable(table))
+		return LUA_NOOBJECT;
+	lua_pushobject(table);
+	lua_pushnumber(index);
+	return lua_rawgettable();
+}
+
+static int storyValue(lua_Object object) {
+	return lua_isnumber(object) ? static_cast<int>(lua_getnumber(object)) : 0;
+}
+
+static void sampleStoryState(ScummWebTelemetry::Sample &sample, GrimGameType gameType) {
+	lua_beginblock();
+	if (gameType == GType_GRIM) {
+		const lua_Object puzzles = lua_rawgetglobal("cur_puzzle_state");
+		if (lua_istable(puzzles)) {
+			byte values[64] = {};
+			for (uint i = 0; i < ARRAYSIZE(values); ++i)
+				values[i] = storyValue(storyIndex(puzzles, i)) != 0;
+			sample.bank("puzzle_flags", values, ARRAYSIZE(values));
+		}
+		const lua_Object cutscenes = storyField(lua_rawgetglobal("cutscene_menu"), "cutscenes");
+		sample.variable("story_state", "final_cutscene_unlocked",
+			storyValue(storyField(storyIndex(cutscenes, 39), "enabled")) != 0);
+	} else {
+		const lua_Object globals = lua_rawgetglobal("glob");
+		sample.variable("story_state", "curr_act", storyValue(storyField(globals, "curr_act")));
+		static const char *const fields[] = {
+			"broke_catapult", "guybrush_read_marley_letter", "caught_pegnose",
+			"been_in_lua_bar", "rock_beach", "rock_canyon", "rock_lava"
+		};
+		for (const char *key : fields)
+			sample.variable("story_state", key, storyValue(storyField(globals, key)) != 0);
+		const lua_Object credits = lua_rawgetglobal("credits_menu");
+		sample.variable("story_state", "credits_end_game", storyValue(storyField(credits, "end_game")));
+	}
+	lua_endblock();
+}
+#endif
