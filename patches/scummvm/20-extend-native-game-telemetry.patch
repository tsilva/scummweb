+#ifdef __EMSCRIPTEN__
+static Common::String scummWebIndexMD5() {
+	Common::File index;
+	if (index.open("resource.map"))
+		return Common::computeStreamMD5AsString(index);
+
+	// SCI32 loads numbered maps with matching volumes. Hash the ordered
+	// names and full map digests so every disc contributes to the identity.
+	Common::String manifest;
+	for (int volume = 0; volume < 100; ++volume) {
+		const Common::String name = Common::String::format("resmap.%03d", volume);
+		if (!Common::File::exists(Common::Path(Common::String::format("ressci.%03d", volume))) ||
+			!index.open(Common::Path(name)))
+			continue;
+
+		const Common::String digest = Common::computeStreamMD5AsString(index);
+		index.close();
+		if (digest.empty())
+			return Common::String();
+		manifest += name + ":" + digest + "\n";
+	}
+
+	if (manifest.empty())
+		return Common::String();
+	Common::MemoryReadStream stream(reinterpret_cast<const byte *>(manifest.c_str()), manifest.size());
+	return Common::computeStreamMD5AsString(stream);
+}
+#endif
