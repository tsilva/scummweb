-void Game::switchTotSub(int16 index, int16 function) {
+#ifdef __EMSCRIPTEN__
+// Callbacks in the original Woodruff MENU.TOT. The first writes CAT.INF and
+// copies the scene properties. The second asks the parent script to restore.
+static constexpr int kWoodruffSaveCallback = 39193;
+static constexpr int kWoodruffLoadCallback = 39155;
+static constexpr uint kWoodruffFileName = 248;
+static constexpr uint kWoodruffSaveLabel = 356;
+static constexpr uint kWoodruffSelectedSlot = 3462;
+static constexpr uint kWoodruffLeavingScene = 3466;
+
+bool Game::hasAgentCheckpointScript() const {
+	if (_vm->getGameType() != kGameTypeWoodruff || _curEnvironment < 1 ||
+			!_curTotFile.hasPrefixIgnoreCase("emap") ||
+			!_environments.getTotFile(_curEnvironment - 1).equalsIgnoreCase("menu.tot"))
+		return false;
+
+	const Script *menu = _environments.getScript(_curEnvironment - 1);
+	if (!menu || menu->getVariablesCount() * 4 != kWoodruffSaveVarBytes)
+		return false;
+
+	static const byte saveSignature[] = {0x01, 0x04, 0x26, 0x00, 0x90, 0x1c, 0x1d, 0x02};
+	static const byte loadSignature[] = {0x01, 0x04, 0x20, 0x00, 0x90, 0x12, 0x8a, 0x0d};
+	const byte *save = menu->getData(kWoodruffSaveCallback + sizeof(saveSignature) - 1);
+	const byte *load = menu->getData(kWoodruffLoadCallback + sizeof(loadSignature) - 1);
+	return save && load &&
+		!memcmp(menu->getData(kWoodruffSaveCallback), saveSignature, sizeof(saveSignature)) &&
+		!memcmp(menu->getData(kWoodruffLoadCallback), loadSignature, sizeof(loadSignature));
+}
+
+bool Game::canAgentCheckpoint() const {
+	const Variables *vars = _vm->_inter->_variables;
+	return _agentControlBoundary && vars && vars->getSize() == kWoodruffSaveVarBytes &&
+		!vars->readOff8(kWoodruffLeavingScene) && !_vm->_inter->_terminate;
+}
+
+bool Game::saveAgentCheckpoint(int slot, const Common::String &desc) {
+	if (!canAgentCheckpoint())
+		return false;
+
+	Variables *vars = _vm->_inter->_variables;
+	vars->writeOffString(kWoodruffFileName, "SAVE\\CAT.INF");
+	vars->writeOffString(kWoodruffSaveLabel, desc.substr(0, 29).c_str());
+	vars->writeOff16(kWoodruffSelectedSlot, slot);
+	_agentSaving = true;
+	_agentSaveFailed = false;
+	switchTotSub(0, kWoodruffSaveCallback);
+	_agentSaving = false;
+	return !_agentSaveFailed;
+}
+
+bool Game::loadAgentCheckpoint(int slot) {
+	if (!canAgentCheckpoint())
+		return false;
+
+	_vm->_inter->_variables->writeOff16(kWoodruffSelectedSlot, slot);
+	switchTotSub(0, kWoodruffLoadCallback);
+	return true;
+}
+
+bool Game::noteAgentSaveFailure() {
+	if (_agentSaving)
+		_agentSaveFailed = true;
+	return _agentSaving;
+}
+#endif
