+#ifdef __EMSCRIPTEN__
+SaveStateList GobMetaEngine::listSaves(const char *target) const {
+	SaveStateList saves;
+	if (!target || !hasFeature(kSupportsListSaves))
+		return saves;
+
+	for (int slot = 0; slot <= getMaximumSaveSlot(); ++slot) {
+		Gob::SavePartInfo info(Gob::SaveLoad_v4::kSlotNameLength, Gob::kGameTypeWoodruff, 0,
+			Gob::kEndiannessLE, Gob::kWoodruffSaveVarBytes);
+		if (Gob::SaveReader::getInfo(getSavegameFile(slot, target), info))
+			saves.push_back(SaveStateDescriptor(this, slot, info.getDesc()));
+	}
+	return saves;
+}
+
+Common::String Gob::GobEngine::getSaveStateName(int slot) const {
+	return getMetaEngine()->getSavegameFile(slot, _targetName.c_str());
+}
+
+bool Gob::GobEngine::canSaveGameStateCurrently(Common::U32String *msg) {
+	return _game && _game->canAgentCheckpoint();
+}
+
+bool Gob::GobEngine::canLoadGameStateCurrently(Common::U32String *msg) {
+	return canSaveGameStateCurrently(msg);
+}
+
+Common::Error Gob::GobEngine::saveGameState(int slot, const Common::String &desc, bool isAutosave) {
+	if (slot < 0 || slot >= int(SaveLoad_v4::kSlotCount) || !canSaveGameStateCurrently())
+		return Common::kWritingFailed;
+
+	return _game->saveAgentCheckpoint(slot, desc) ? Common::kNoError : Common::kWritingFailed;
+}
+
+Common::Error Gob::GobEngine::loadGameState(int slot) {
+	if (slot < 0 || slot >= int(SaveLoad_v4::kSlotCount) || !canLoadGameStateCurrently())
+		return Common::kReadingFailed;
+
+	SaveReader reader(3, slot, getSaveStateName(slot));
+	SavePartInfo info(SaveLoad_v4::kSlotNameLength, getGameType(), 0, getEndianness(), kWoodruffSaveVarBytes);
+	if (!reader.load() || !reader.readPart(0, &info))
+		return Common::kReadingFailed;
+
+	return _game->loadAgentCheckpoint(slot) ? Common::kNoError : Common::kReadingFailed;
+}
+#endif
