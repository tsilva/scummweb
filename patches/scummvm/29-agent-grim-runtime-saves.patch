+Common::Error GrimEngine::saveGameState(int slot, const Common::String &desc, bool isAutosave) {
+	if (isAutosave || slot < 1 || slot > 99 || !canSaveGameStateCurrently())
+		return Common::kWritingFailed;
+	_savegameFileName = getSaveStateName(slot);
+	return savegameSave(&desc) ? Common::kNoError : Common::kWritingFailed;
+}
