+void DreamWebEngine::checkBrowserOpeningSkip() {
+	if (!_browserOpening || !ScummWebIntro::nativeSkipEnabled())
+		return;
+	if (_browserSkipOpening || ScummWebIntro::skipRequested()) {
+		_browserSkipOpening = true;
+		_lastHardKey = Common::KEYCODE_ESCAPE;
+		ScummWebIntro::skipRequested(false);
+	}
+}
+#endif
+
 void DreamWebEngine::hangOne(uint16 delay) {
 	do {
 		waitForVSync();
+#ifdef __EMSCRIPTEN__
+		checkBrowserOpeningSkip();
+#endif
 		if (_lastHardKey == Common::KEYCODE_ESCAPE)
 			return; // "hangonearly"
 	} while	(--delay);
 }
 
