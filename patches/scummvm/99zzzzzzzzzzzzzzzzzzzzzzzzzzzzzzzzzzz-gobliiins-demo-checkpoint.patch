+using Object = Goblin::Gob_Object;
+
+struct Gob1Actor {
+	byte present;
+	byte stateMachine;
+	byte motion[offsetof(Object, stateMach)];
+	byte flags[sizeof(Object) - offsetof(Object, doAnim)];
+};
+
+struct Gob1Scene {
+	byte room;
+	byte variables[kGob1DemoVars];
+	Gob1Actor actors[24];
+	int16 current, action, destinationX, destinationY, pressedX, pressedY;
+	int16 stateLayer, positioned, pocketIndex, pocketId, destinationId;
+	int16 destinationAction, destinationType, destinationState, activeObject;
+	char goesAtTarget, readyToAct, pathExistence, itemByteFlag, boredom, noPick;
+	Goblin::Gob_Pos positions[3];
+	int16 itemToObject[20], forceNextState[10];
+	int16 mapX, mapY, mapDestinationX, mapDestinationY, waypoint, nearestDestination;
+	ItemPos itemPositions[40];
+	int8 pass[kGob1MapHeight][kGob1MapWidth];
+	int16 items[kGob1MapHeight][kGob1MapWidth];
+	Video::Color palette[256];
+	byte pixels[2][kGob1Width * kGob1Height];
+};
+
+Object *checkpointActor(Goblin &goblin, int index) {
+	return index < 4 ? goblin._goblins[index] : goblin._objects[index - 4];
+}
+
+bool syncGob1Actors(Goblin &goblin, Gob1Scene &scene, bool load) {
+	for (int index = 0; index < ARRAYSIZE(scene.actors); ++index) {
+		Object *actor = checkpointActor(goblin, index);
+		Gob1Actor &record = scene.actors[index];
+		if (load && record.present != !!actor)
+			return false;
+		if (!actor)
+			continue;
+		if (!load) {
+			record.present = true;
+			if (actor->stateMach != actor->realStateMach) {
+				for (int n = 0; n < ARRAYSIZE(goblin._goblins); ++n)
+					if (goblin._goblins[n] && actor->stateMach == goblin._goblins[n]->realStateMach)
+						record.stateMachine = n + 1;
+				if (!record.stateMachine)
+					return false;
+			}
+			memcpy(record.motion, actor, sizeof(record.motion));
+			memcpy(record.flags, &actor->doAnim, sizeof(record.flags));
+		} else {
+			if (record.stateMachine > ARRAYSIZE(goblin._goblins) ||
+					(record.stateMachine && !goblin._goblins[record.stateMachine - 1]))
+				return false;
+			Object check = *actor;
+			memcpy(&check, record.motion, sizeof(record.motion));
+			memcpy(&check.doAnim, record.flags, sizeof(record.flags));
+			const int stateCount = index == 3 || record.stateMachine == 4 ? 70 : 40;
+			if (check.state < -1 || check.state >= stateCount ||
+					check.stateColumn < 0 || check.stateColumn >= 6 ||
+					check.curFrame < 0 || check.curFrame >= 2048 ||
+					check.multObjIndex < -1 || check.multObjIndex >= ARRAYSIZE(goblin._goblins))
+				return false;
+		}
+	}
+	if (load) {
+		for (int index = 0; index < ARRAYSIZE(scene.actors); ++index) {
+			const Gob1Actor &record = scene.actors[index];
+			if (!record.present)
+				continue;
+			Object &actor = *checkpointActor(goblin, index);
+			memcpy(&actor, record.motion, sizeof(record.motion));
+			memcpy(&actor.doAnim, record.flags, sizeof(record.flags));
+			actor.stateMach = record.stateMachine
+				? goblin._goblins[record.stateMachine - 1]->realStateMach : actor.realStateMach;
+		}
+	}
+	return true;
+}
