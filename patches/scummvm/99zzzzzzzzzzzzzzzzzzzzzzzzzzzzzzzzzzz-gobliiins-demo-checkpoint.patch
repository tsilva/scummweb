+int Game::getGob1CheckpointRoom() const {
+	if (!_vm->matchesGob1CheckpointTarget("gob1-demo"))
+		return -1;
+
+	static constexpr byte input[] = {2, 15, 2, 8, 0, 1, 0, 0, 2, 64, 1, 200, 0, 1, 0, 1};
+	for (int index = 0; index < ARRAYSIZE(kGob1DemoRooms); ++index) {
+		const auto &room = kGob1DemoRooms[index];
+		if (_vm->isCurrentTot(room.name) && _script->getTextsOffset() == room.texts &&
+				_script->getData(room.input + sizeof(input) - 1) &&
+				!memcmp(_script->getData(room.input), input, sizeof(input)))
+			return index;
+	}
+	return -1;
+}
+
+bool Game::hasGob1CheckpointSurface() const {
+	for (const auto &surface : {_vm->_draw->_frontSurface, _vm->_draw->_backSurface}) {
+		if (!surface || surface->getWidth() != kGob1Width ||
+				surface->getHeight() != kGob1Height || surface->getBPP() != 1)
+			return false;
+	}
+	return _vm->_map->getMapWidth() == kGob1MapWidth && _vm->_map->getMapHeight() == kGob1MapHeight;
+}
+
+bool Game::validGob1CheckpointHeader(Common::SeekableReadStream &file) {
+	if (file.size() != 4 + sizeof(Gob1Scene) || file.readUint32BE() != kGob1Magic)
+		return false;
+	return file.readByte() < ARRAYSIZE(kGob1DemoRooms) && file.seek(4);
+}
+
+bool Game::saveGob1Checkpoint(int slot) {
+	Common::Array<Gob1Scene> data(1);
+	Gob1Scene &scene = data[0];
+	memset(&scene, 0, sizeof(scene));
+	scene.room = getGob1CheckpointRoom();
+	if (!syncGob1Actors(*_vm->_goblin, scene, false))
+		return false;
+	syncGob1Scene(*_vm, scene, false);
+
+	Common::OutSaveFile *file = _vm->getSaveFileManager()->openForSaving(_vm->getSaveStateName(slot));
+	if (!file)
+		return false;
+	file->writeUint32BE(kGob1Magic);
+	const bool complete = file->write(&scene, sizeof(scene)) == sizeof(scene);
+	file->finalize();
+	const bool success = complete && !file->err();
+	delete file;
+	return success;
+}
+
+bool Game::loadGob1Checkpoint(int slot) {
+	if (!_gob1Checkpoint.empty())
+		return false;
+	Common::InSaveFile *file = _vm->getSaveFileManager()->openForLoading(_vm->getSaveStateName(slot));
+	if (!file)
+		return false;
+	Common::Array<byte> state;
+	if (validGob1CheckpointHeader(*file)) {
+		state.resize(sizeof(Gob1Scene));
+		if (file->read(state.data(), state.size()) != state.size())
+			state.clear();
+	}
+	delete file;
+	if (state.empty())
+		return false;
+
+	_gob1Checkpoint.swap(state);
+	_totToLoad = kGob1DemoRooms[_gob1Checkpoint[0]].name;
+	_vm->_inter->_terminate = 1;
+	return true;
+}
+
+void Game::applyGob1Checkpoint() {
+	if (getGob1CheckpointRoom() != _gob1Checkpoint[0])
+		return;
+
+	Common::Array<Gob1Scene> data(1);
+	Gob1Scene &scene = data[0];
+	memcpy(&scene, _gob1Checkpoint.data(), sizeof(scene));
+	_gob1Checkpoint.clear();
+	if (scene.current < 0 || scene.current >= 3 || scene.activeObject < -1 ||
+			scene.activeObject >= 20 || !hasGob1CheckpointSurface() ||
+			!syncGob1Actors(*_vm->_goblin, scene, true)) {
+		EM_ASM({ globalThis.__scummwebAgentSaveResult?.("The Gobliiins checkpoint could not be restored."); });
+		return;
+	}
+	syncGob1Scene(*_vm, scene, true);
+}
