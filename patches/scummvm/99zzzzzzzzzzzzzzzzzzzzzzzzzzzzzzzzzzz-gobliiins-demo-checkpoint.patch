+template<class Saved, class Current>
+void transferGob1Field(Saved &saved, Current &current, bool load) {
+	static_assert(sizeof(saved) == sizeof(current), "Checkpoint field width changed");
+	if (load)
+		memcpy(&current, &saved, sizeof(saved));
+	else
+		memcpy(&saved, &current, sizeof(saved));
+}
+
+void syncGob1Scene(GobEngine &vm, Gob1Scene &scene, bool load) {
+	auto &goblin = *vm._goblin;
+	auto &map = *vm._map;
+	auto &draw = *vm._draw;
+	transferGob1Field(scene.current, goblin._currentGoblin, load);
+	transferGob1Field(scene.action, goblin._gobAction, load);
+	transferGob1Field(scene.destinationX, goblin._gobDestX, load);
+	transferGob1Field(scene.destinationY, goblin._gobDestY, load);
+	transferGob1Field(scene.pressedX, goblin._pressedMapX, load);
+	transferGob1Field(scene.pressedY, goblin._pressedMapY, load);
+	transferGob1Field(scene.stateLayer, goblin._gobStateLayer, load);
+	transferGob1Field(scene.positioned, goblin._positionedGob, load);
+	transferGob1Field(scene.pocketIndex, goblin._itemIndInPocket, load);
+	transferGob1Field(scene.pocketId, goblin._itemIdInPocket, load);
+	transferGob1Field(scene.destinationId, goblin._destItemId, load);
+	transferGob1Field(scene.destinationAction, goblin._destActionItem, load);
+	transferGob1Field(scene.destinationType, goblin._destItemType, load);
+	transferGob1Field(scene.destinationState, goblin._destItemState, load);
+	transferGob1Field(scene.goesAtTarget, goblin._goesAtTarget, load);
+	transferGob1Field(scene.readyToAct, goblin._readyToAct, load);
+	transferGob1Field(scene.pathExistence, goblin._pathExistence, load);
+	transferGob1Field(scene.itemByteFlag, goblin._itemByteFlag, load);
+	transferGob1Field(scene.boredom, goblin._boreCounter, load);
+	transferGob1Field(scene.noPick, goblin._noPick, load);
+	transferGob1Field(scene.positions, goblin._gobPositions, load);
+	transferGob1Field(scene.itemToObject, goblin._itemToObject, load);
+	transferGob1Field(scene.forceNextState, goblin._forceNextState, load);
+	transferGob1Field(scene.itemPositions, map._itemPoses, load);
+	transferGob1Field(scene.mapX, map._curGoblinX, load);
+	transferGob1Field(scene.mapY, map._curGoblinY, load);
+	transferGob1Field(scene.mapDestinationX, map._destX, load);
+	transferGob1Field(scene.mapDestinationY, map._destY, load);
+	transferGob1Field(scene.waypoint, map._nearestWayPoint, load);
+	transferGob1Field(scene.nearestDestination, map._nearestDest, load);
+	transferGob1Field(scene.palette, draw._vgaPalette, load);
+	for (int y = 0; y < kGob1MapHeight; ++y) {
+		for (int x = 0; x < kGob1MapWidth; ++x) {
+			if (load) {
+				map.setPass(x, y, scene.pass[y][x]);
+				map.setItem(x, y, scene.items[y][x]);
+			} else {
+				scene.pass[y][x] = map.getPass(x, y);
+				scene.items[y][x] = map.getItem(x, y);
+			}
+		}
+	}
+	if (load) {
+		goblin._actDestItemDesc = scene.activeObject < 0 ? nullptr : goblin._objects[scene.activeObject];
+		vm._inter->_variables->copyFrom(0, scene.variables, kGob1DemoVars);
+		memcpy(draw._frontSurface->getData(), scene.pixels[0], sizeof(scene.pixels[0]));
+		memcpy(draw._backSurface->getData(), scene.pixels[1], sizeof(scene.pixels[1]));
+		vm._video->setFullPalette(vm._global->_pPaletteDesc);
+		draw.invalidateRect(0, 0, kGob1Width - 1, kGob1Height - 1);
+	} else {
+		scene.activeObject = -1;
+		for (int index = 0; index < ARRAYSIZE(goblin._objects); ++index) {
+			if (goblin._objects[index] && goblin._objects[index] == goblin._actDestItemDesc)
+				scene.activeObject = index;
+		}
+		vm._inter->_variables->copyTo(0, scene.variables, kGob1DemoVars);
+		memcpy(scene.pixels[0], draw._frontSurface->getData(), sizeof(scene.pixels[0]));
+		memcpy(scene.pixels[1], draw._backSurface->getData(), sizeof(scene.pixels[1]));
+	}
+}
