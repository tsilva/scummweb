+// ScummWEB's private host bridge. Storage implementations and transfers remain upstream.
+#include "backends/cloud/cloudmanager.h"
+#include "backends/cloud/basestorage.h"
+#include "common/config-manager.h"
+#include "common/formats/json.h"
+#include "common/file.h"
+#include "common/fs.h"
+
+EM_JS(char *, scummwebCloudTakeCommand, (), {
+  const command = globalThis.__scummwebCloudCommand;
+  if (!command) return 0;
+  globalThis.__scummwebCloudCommand = null;
+  return stringToNewUTF8(JSON.stringify(command));
+});
+EM_JS(void, scummwebCloudReply, (const char *json), {
+  globalThis.__scummwebCloudReply?.(JSON.parse(UTF8ToString(json)));
+});
+
+class ScummwebCloudService {
+  bool _busy = false;
+  void reply(Common::JSONObject result) {
+    result.setVal("ok", new Common::JSONValue(true));
+    Common::JSONValue value(result);
+    scummwebCloudReply(value.stringify().c_str());
+    _busy = false;
+  }
+public:
+  void error(const Networking::ErrorResponse &response) {
+    // Do not expose provider response bodies: OAuth responses can contain credentials.
+    const char *kind = response.httpResponseCode == 401 || response.httpResponseCode == 400 ? "auth" :
+      response.response.contains("not_found") ? "missing" : "request";
+    Common::JSONObject result;
+    result.setVal("ok", new Common::JSONValue(false));
+    result.setVal("kind", new Common::JSONValue(kind));
+    Common::JSONValue value(result);
+    scummwebCloudReply(value.stringify().c_str());
+    _busy = false;
+  }
+  void done(const Cloud::Storage::BoolResponse &response) {
+    if (!response.value) { error(Networking::ErrorResponse(nullptr, "Cloud operation failed")); return; }
+    reply(Common::JSONObject());
+  }
+  void refreshed(const Cloud::Storage::BoolResponse &response) {
+    if (!response.value) { error(Networking::ErrorResponse(nullptr, false, true, "Authorization expired", 401)); return; }
+    reply(Common::JSONObject());
+  }
+  void uploaded(const Cloud::Storage::UploadResponse &) { reply(Common::JSONObject()); }
+  void listed(const Cloud::Storage::ListDirectoryResponse &response) {
+    Common::JSONArray entries;
+    for (const Cloud::StorageFile &file : response.value) {
+      Common::JSONObject entry;
+      entry.setVal("name", new Common::JSONValue(file.name()));
+      entry.setVal("size", new Common::JSONValue((double)file.size()));
+      entry.setVal("directory", new Common::JSONValue(file.isDirectory()));
+      entry.setVal("modifiedAt", new Common::JSONValue((double)file.timestamp() * 1000));
+      entry.setVal("revision", new Common::JSONValue(file.revision()));
+      entries.push_back(new Common::JSONValue(entry));
+    }
+    Common::JSONObject result;
+    result.setVal("entries", new Common::JSONValue(entries));
+    reply(result);
+  }
+  void command(const char *text) {
+    const Common::JSONValue *json = Common::JSON::parse(text);
+    if (!json || !json->isObject()) { delete json; return; }
+    const Common::JSONObject data = json->asObject();
+    const Common::String op = data.getVal("op")->asString();
+    const Common::String name = data.contains("name") ? data.getVal("name")->asString() : "";
+    delete json;
+    if (_busy) return;
+    _busy = true;
+    Cloud::Storage *storage = CloudMan.getCurrentStorage();
+    if (!storage) { error(Networking::ErrorResponse(nullptr, false, true, "Not connected", 401)); return; }
+    // Cloud sync owns one folder; desktop saves use the host import/export UI.
+    Common::String remote = "/saves/";
+    if (op == "upload" || op == "download") {
+      if (name.size() != 68 || !name.hasSuffix(".zip")) { error(Networking::ErrorResponse(nullptr, "Invalid snapshot")); return; }
+      for (uint i = 0; i < 64; ++i) {
+        if (!((name[i] >= '0' && name[i] <= '9') || (name[i] >= 'a' && name[i] <= 'f'))) {
+          error(Networking::ErrorResponse(nullptr, "Invalid snapshot")); return;
+        }
+      }
+      remote += name;
+    }
+    Networking::ErrorCallback ecb = new Common::Callback<ScummwebCloudService, const Networking::ErrorResponse &>(this, &ScummwebCloudService::error);
+    Cloud::Storage::BoolCallback cb = new Common::Callback<ScummwebCloudService, const Cloud::Storage::BoolResponse &>(this, &ScummwebCloudService::done);
+    if (op == "refresh") {
+      delete cb;
+      static_cast<Cloud::BaseStorage *>(storage)->refreshAccessToken(new Common::Callback<ScummwebCloudService, const Cloud::Storage::BoolResponse &>(this, &ScummwebCloudService::refreshed), ecb);
+    } else if (op == "list") {
+      delete cb;
+      storage->listDirectory(remote, new Common::Callback<ScummwebCloudService, const Cloud::Storage::ListDirectoryResponse &>(this, &ScummwebCloudService::listed), ecb);
+    } else if (op == "mkdir") {
+      storage->createDirectory("/saves", cb, ecb);
+    } else if (op == "download") {
+      storage->download(remote, Common::Path("/cloud/transfer"), cb, ecb);
+    } else if (op == "upload") {
+      delete cb;
+      storage->upload(remote, Common::FSNode(Common::Path("/cloud/transfer")).createReadStream(), new Common::Callback<ScummwebCloudService, const Cloud::Storage::UploadResponse &>(this, &ScummwebCloudService::uploaded), ecb);
+    } else {
+      delete cb; delete ecb;
+      error(Networking::ErrorResponse(nullptr, "Unknown cloud operation"));
+    }
+  }
+};
+
+int runScummwebCloudService() {
+  ConfMan.loadConfigFile(Common::Path("/cloud/config.ini"), Common::Path());
+  g_system->initBackend();
+  CloudMan.init();
+  ScummwebCloudService service;
+  EM_ASM({ globalThis.__scummwebCloudReady?.(); });
+  // No launcher, wizard, engine plugins, game filesystem or OSD is initialized.
+  for (;;) {
+    char *command = scummwebCloudTakeCommand();
+    if (command) { service.command(command); free(command); }
+    g_system->delayMillis(20);
+  }
+  return 0;
+}
