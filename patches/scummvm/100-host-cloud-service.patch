+namespace {
+Common::String cloudFormEncode(const Common::String &value) {
+ Common::String result;
+ for (uint i = 0; i < value.size(); ++i) {
+  const unsigned char c = value[i];
+  if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~') result += c;
+  else result += Common::String::format("%%%02X", c);
+ }
+ return result;
+}
+class ScummwebDropboxRefresh : public Networking::HttpJsonRequest {
+public:
+ ScummwebDropboxRefresh(Networking::JsonCallback cb, Networking::ErrorCallback ecb) : HttpJsonRequest(cb, ecb, "https://api.dropboxapi.com/oauth2/token") {}
+ void finishJson(const Common::JSONValue *json) override {
+  if (!json || !json->isObject() || !json->asObject().contains("access_token")) {
+   delete json;
+   finishError(Networking::ErrorResponse(this, false, true, "Dropbox authorization expired", 401));
+   return;
+  }
+  Common::JSONObject oauth;
+  oauth.setVal("access_token", new Common::JSONValue(json->asObject().getVal("access_token")->asString()));
+  Common::JSONObject result;
+  result.setVal("error", new Common::JSONValue(false));
+  result.setVal("oauth", new Common::JSONValue(oauth));
+  delete json;
+  HttpJsonRequest::finishJson(new Common::JSONValue(result));
+ }
+};
+}
