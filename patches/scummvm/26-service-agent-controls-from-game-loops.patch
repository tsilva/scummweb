 Common::Error DreamWebEngine::saveGameState(int slot, const Common::String &desc, bool isAutosave) {
+#ifdef __EMSCRIPTEN__
+	if (isAutosave || !canSaveGameStateCurrently())
+		return Common::kWritingFailed;
+
+	// The native format prefixes the description with a marker and pads it
+	// to 17 bytes. Use the same format as the game's own save dialog.
+	char description[17];
+	memset(description, 1, sizeof(description));
+	description[0] = 2;
+	Common::strlcpy(description + 1, desc.c_str(), sizeof(description) - 1);
+	if (ConfMan.getBool("originalsaveload"))
+		createThumbnail(_thumbnail);
+	return savePosition(slot, description, false) ? Common::kNoError : Common::kWritingFailed;
+#else
 	return Common::kNoError;
-}
+#endif
