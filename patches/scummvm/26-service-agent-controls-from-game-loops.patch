diff --git a/engines/scummweb-agent-loop.h b/engines/scummweb-agent-loop.h
new file mode 100644
--- /dev/null
+++ b/engines/scummweb-agent-loop.h
@@ -0,0 +1,27 @@
+#ifndef ENGINES_SCUMMWEB_AGENT_LOOP_H
+#define ENGINES_SCUMMWEB_AGENT_LOOP_H
+
+#ifdef __EMSCRIPTEN__
+extern "C" bool scummweb_agent_game_loop_enabled();
+extern "C" void scummweb_agent_use_game_loop(bool enable);
+extern "C" void scummweb_agent_game_loop();
+
+// Use a top-level update after the engine has unlocked and presented its
+// buffers. Native serializers can redraw or rebuild the scene from here.
+class ScummWebAgentLoop {
+	bool _enabled = false;
+public:
+	explicit ScummWebAgentLoop(bool enabled = true) { setEnabled(enabled); }
+	~ScummWebAgentLoop() { setEnabled(false); }
+	void setEnabled(bool enabled) {
+		if (_enabled != enabled) {
+			scummweb_agent_use_game_loop(enabled);
+			_enabled = enabled;
+		}
+	}
+	ScummWebAgentLoop(const ScummWebAgentLoop &) = delete;
+	ScummWebAgentLoop &operator=(const ScummWebAgentLoop &) = delete;
+};
+#endif
+
+#endif
