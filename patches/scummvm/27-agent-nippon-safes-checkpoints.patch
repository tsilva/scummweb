+Common::Error Parallaction::saveGameState(int slot, const Common::String &desc, bool isAutosave) {
+	if (isAutosave || !scummweb_agent_game_loop_enabled() || !canSaveGameStateCurrently() || slot < 1 || slot > 99)
+		return Common::kWritingFailed;
+	return _saveLoad->saveAgentSlot(slot, desc.c_str()) ? Common::kNoError : Common::kWritingFailed;
+}
+
+Common::Error Parallaction::loadGameState(int slot) {
+	if (!scummweb_agent_game_loop_enabled() || !canLoadGameStateCurrently() || slot < 1 || slot > 99)
+		return Common::kReadingFailed;
+	return _saveLoad->loadAgentSlot(slot) ? Common::kNoError : Common::kReadingFailed;
+}
